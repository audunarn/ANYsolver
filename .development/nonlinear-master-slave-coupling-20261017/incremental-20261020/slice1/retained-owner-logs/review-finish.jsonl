{"id": "effect-f0a7a0a6-cb75-5cdc-a183-20e3b0167c72", "sessionId": "0e52355a-e62d-b576-da1e-37b93dc91667", "turnId": "turn-4678590911a48f01faf542a7142cac04", "createdAt": 1792488621683, "updatedAt": 1792488621730, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:/Github/ANYsolver/examples/beam_shell_coupling.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:/Github/ANYsolver/examples/beam_shell_coupling.py", "settledVerb": "Read", "settledMessage": "C:/Github/ANYsolver/examples/beam_shell_coupling.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:/Github/ANYsolver/examples/beam_shell_coupling.py", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\examples\\beam_shell_coupling.py", "content": "\"\"\"Standalone public beam-shell coupling example: registered pre-yield case.\n\nThis example builds the registered eccentric beam-shell coupling case with\npublic ``anysolver`` APIs only and solves it with the registered pre-yield\nforce-controlled controls. It reports a truthful JSON summary: ``completed``\nis true only when the solver actually reached the requested load factor\nwithin 1e-8 and the existing constraint postcheck passed; anything else\n(including cooperative cancellation) is reported as non-completion and the\nprocess exit status is nonzero.\n\nGeometry and material follow the registered Slice 3 continuation fixture:\nL = 1 m panel of width W = 0.24 m, t = 0.012 m, a 2x1 shell grid, one\n10x40 mm stiffener at eccentricity e = +0.04 m, canonical S355 curve,\n-2000 N uz on every shell-tip node, 6 load steps, at most 30 iterations per\nstep, tolerance 1e-8, corotational kinematics. ``direct`` couples each beam\nnode to one shell edge node; ``interpolated`` (default) couples genuinely\ninterpolated mid-span beam nodes to weighted shell masters.\n\nCommand line::\n\n    python examples/beam_shell_coupling.py [--coupling direct|interpolated]\n                                          [--output results.json]\n\nThe JSON summary is always written to stdout; with ``--output`` the same\ndocument is also written to the given path. Exit status 0 means valid\ncompletion only.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom dataclasses import dataclass\nfrom typing import Any, Callable, Optional\n\nimport numpy as np\n\nfrom anysolver import (\n    BoundaryCondition,\n    CoupledBeamShellElement,\n    CancellationToken,\n    FEModel,\n    InterpolatedBeamShellMPCElement,\n    LoadCase,\n    create_shell_element,\n    solve_static_nonlinear,\n    SolveCancelled,\n)\nfrom anysolver.elements import BeamElement\nfrom anysolver.material_curves import DNVC208MaterialCurve, dnv_c208_steel_curve\n\nL = 1.0\nW = 0.24\nT = 0.012\nNX = 2\nNY = 1\nECCENTRICITY = np.array([0.0, 0.0, 0.04])\nBEAM_SECTION = {\n    \"area\": 4.0e-4,\n    \"Iy\": 0.01 * 0.04**3 / 12.0,\n    \"Iz\": 0.04 * 0.01**3 / 12.0,\n    \"J\": 1.0e-8,\n    \"b\": 0.01,\n    \"h\": 0.04,\n    \"fiber_plasticity\": True,\n}\nTIP_LOAD_PER_NODE = -2000.0\nNUM_STEPS = 6\nMAX_ITERATIONS = 30\nTOLERANCE = 1.0e-8\nREQUESTED_LOAD_FACTOR = 1.0\nCOMPLETION_LOAD_FACTOR_TOL = 1.0e-8\n\nCOUPLINGS = (\"direct\", \"interpolated\")\nDEFAULT_COUPLING = \"interpolated\"\n\n\n@dataclass\nclass BeamShellCase:\n    \"\"\"Built, constrained and loaded model plus its probe node id.\"\"\"\n\n    coupling: str\n    model: FEModel\n    load: LoadCase\n    probe_node_id: int\n\n\ndef _add_s355_material(model: FEModel) -> None:\n    \"\"\"Canonical S355 curve at the panel thickness (registered scale 1.0).\"\"\"\n    base = dnv_c208_steel_curve(\"S355\", T).as_dict()\n    hardening = DNVC208MaterialCurve(\n        base[\"sigma_prop\"],\n        base[\"sigma_yield\"],\n        base[\"sigma_yield_2\"],\n        base[\"eps_p_y1\"],\n        base[\"eps_p_y2\"],\n        base[\"K\"],\n        base[\"n\"],\n    )\n    model.add_material(\n        \"steel\",\n        2.1e11,\n        0.3,\n        density=7850.0,\n        yield_stress=base[\"sigma_yield\"],\n        hardening_curve=hardening,\n    )\n\n\ndef build_model(coupling: str = DEFAULT_COUPLING) -> BeamShellCase:\n    \"\"\"Build the registered pre-yield case for ``direct`` or ``interpolated``.\n\n    Node identities are deterministic construction ids: shell grid nodes\n    1..(NX+1)*(NY+1), beam nodes 100+ib, MPC elements 200+ib and beam\n    elements 300+ib. ``direct`` uses 2 beam elements on shell edge nodes;\n    ``interpolated`` uses 3 beam elements with genuinely interpolated\n    mid-span beam nodes.\n    \"\"\"\n    if coupling not in COUPLINGS:\n        raise ValueError(f\"unknown coupling {coupling!r}; expected one of {COUPLINGS}\")\n    model = FEModel(f\"beam_shell_{coupling}\")\n    _add_s355_material(model)\n    grid: dict[tuple[int, int], int] = {}\n    node_id = 1\n    for ix, x in enumerate(np.linspace(0.0, L, NX + 1)):\n        for iy, y in enumerate(np.linspace(-W / 2.0, W / 2.0, NY + 1)):\n            model.add_node(node_id, float(x), float(y), 0.0)\n            grid[(ix, iy)] = node_id\n            node_id += 1\n    element_id = 1\n    for ix in range(NX):\n        for iy in range(NY):\n            model.add_element(\n                element_id,\n                create_shell_element(\n                    element_id,\n                    [\n                        grid[(ix, iy)],\n                        grid[(ix + 1, iy)],\n                        grid[(ix + 1, iy + 1)],\n                        grid[(ix, iy + 1)],\n                    ],\n                    \"steel\",\n                    thickness=T,\n                ),\n            )\n            element_id += 1\n    n_beam = 2 if coupling == \"direct\" else 3\n    beam_nodes: list[int] = []\n    for ib, xb in enumerate(np.linspace(0.0, L, n_beam + 1)):\n        beam_node = 100 + ib\n        model.add_node(beam_node, float(xb), -W / 2.0, float(ECCENTRICITY[2]))\n        beam_nodes.append(beam_node)\n        sx = xb / (L / NX)\n        ix = min(int(np.floor(sx)), NX - 1)\n        xi = sx - ix\n        masters = [(grid[(ix, 0)], 1.0 - xi), (grid[(ix + 1, 0)], xi)]\n        masters = [(n, w) for n, w in masters if w > 1.0e-12]\n        mpc_id = 200 + ib\n        if len(masters) == 1:\n            model.add_element(\n                mpc_id,\n                CoupledBeamShellElement(\n                    mpc_id, beam_node, masters[0][0], \"steel\",\n                    eccentricity=ECCENTRICITY,\n                ),\n            )\n        else:\n            weights = np.array([w for _, w in masters], dtype=float)\n            model.add_element(\n                mpc_id,\n                InterpolatedBeamShellMPCElement(\n                    mpc_id, beam_node, [n for n, _ in masters], weights,\n                    eccentricity=ECCENTRICITY,\n                ),\n            )\n    for ib in range(n_beam):\n        model.add_element(\n            300 + ib,\n            BeamElement(300 + ib, [beam_nodes[ib], beam_nodes[ib + 1]],\n                        \"steel\", dict(BEAM_SECTION)),\n        )\n    model.add_boundary_condition(\n        BoundaryCondition(\n            \"root\",\n            [grid[(0, iy)] for iy in range(NY + 1)],\n            {name: 0.0 for name in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")},\n        )\n    )\n    model.apply_boundary_conditions()\n    load = LoadCase(\"tip\")\n    for iy in range(NY + 1):\n        load.add_nodal_load(\n            grid[(NX, iy)],\n            [0.0, 0.0, TIP_LOAD_PER_NODE, 0.0, 0.0, 0.0],\n        )\n    model.add_load_case(load)\n    return BeamShellCase(\n        coupling=coupling, model=model, load=load, probe_node_id=grid[(NX, 0)]\n    )\n\n\nclass _AcceptedHistory:\n    \"\"\"Count accepted increments through public progress events.\"\"\"\n\n    def __init__(self, observer: Optional[Callable[[Any], None]] = None) -> None:\n        self.accepted_increments = 0\n        self.last_accepted_load_factor: Optional[float] = None\n        self._observer = observer\n\n    def __call__(self, event: Any) -> None:\n        if str(event.get(\"event_type\")) == \"nonlinear_static_step\":\n            self.accepted_increments += 1\n            load_factor = event.get(\"load_factor\")\n            if load_factor is not None:\n                self.last_accepted_load_factor = float(load_factor)\n        if self._observer is not None:\n            self._observer(event)\n\n\ndef _probe_uz(case: BeamShellCase, displacements: np.ndarray) -> float:\n    dofs = case.model.mesh.dof_manager.get_node_dofs(case.probe_node_id)\n    return float(np.asarray(displacements)[dofs[2]])\n\n\ndef run(\n    coupling: str = DEFAULT_COUPLING,\n    *,\n    case: Optional[BeamShellCase] = None,\n    cancellation_token: Optional[CancellationToken] = None,\n    progress_callback: Optional[Callable[[Any], None]] = None,\n) -> dict:\n    \"\"\"Solve the registered pre-yield case and return the JSON payload.\n\n    The payload is truthful: ``completed`` requires solver status\n    ``completed``, an achieved load factor within\n    ``COMPLETION_LOAD_FACTOR_TOL`` of the requested one, and a passing\n    existing constraint postcheck. A cancelled solve reports the accepted\n    increment information visible through public progress events and never\n    claims completion.\n    \"\"\"\n    if case is None:\n        case = build_model(coupling)\n    history = _AcceptedHistory(progress_callback)\n    try:\n        result = solve_static_nonlinear(\n            case.model,\n            case.load,\n            kinematics=\"corotational\",\n            num_steps=NUM_STEPS,\n            max_iterations=MAX_ITERATIONS,\n            tolerance=TOLERANCE,\n            record_increment_snapshots=True,\n            cancellation_token=cancellation_token,\n            progress_callback=history,\n        )\n    except SolveCancelled as cancelled:\n        return {\n            \"coupling\": case.coupling,\n            \"status\": \"cancelled\",\n            \"stop_reason\": str(cancelled.reason),\n            \"requested_load_factor\": REQUESTED_LOAD_FACTOR,\n            \"achieved_load_factor\": history.last_accepted_load_factor,\n            \"probe_displacement\": None,\n            \"accepted_increments\": history.accepted_increments,\n            \"constraint_postcheck\": None,\n            \"completed\": False,\n        }\n    postcheck = result.info.get(\"constraint_postcheck\")\n    achieved = float(result.load_factor)\n    completed = bool(\n        result.status == \"completed\"\n        and abs(achieved - REQUESTED_LOAD_FACTOR) <= COMPLETION_LOAD_FACTOR_TOL\n        and isinstance(postcheck, dict)\n        and postcheck.get(\"status\") == \"passed\"\n    )\n    return {\n        \"coupling\": case.coupling,\n        \"status\": result.status,\n        \"stop_reason\": result.stop_reason,\n        \"requested_load_factor\": REQUESTED_LOAD_FACTOR,\n        \"achieved_load_factor\": achieved,\n        \"probe_displacement\": _probe_uz(case, result.displacements),\n        \"accepted_increments\": len(result.steps),\n        \"constraint_postcheck\": postcheck,\n        \"completed\": completed,\n    }\n\n\ndef main(argv: Optional[list] = None) -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Registered pre-yield beam-shell coupling example\"\n    )\n    parser.add_argument(\n        \"--coupling\", choices=COUPLINGS, default=DEFAULT_COUPLING,\n        help=\"beam-to-shell coupling law (default: %(default)s)\",\n    )\n    parser.add_argument(\n        \"--output\", default=None,\n        help=\"optional path that additionally receives the JSON document\",\n    )\n    args = parser.parse_args(argv)\n    payload = run(args.coupling)\n    document = json.dumps(payload, indent=2)\n    print(document)\n    if args.output is not None:\n        with open(args.output, \"w\", encoding=\"utf-8\") as stream:\n            stream.write(document + \"\\n\")\n    return 0 if payload[\"completed\"] else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "numLines": 312, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "312 lines from C:\\Github\\ANYsolver\\examples\\beam_shell_coupling.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "effect-79e38a97-65af-515d-8010-a1c7021794af", "sessionId": "0e52355a-e62d-b576-da1e-37b93dc91667", "turnId": "turn-4678590911a48f01faf542a7142cac04", "createdAt": 1792488621691, "updatedAt": 1792488621747, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:/Github/ANYsolver/tests/test_beam_shell_workflow.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:/Github/ANYsolver/tests/test_beam_shell_workflow.py", "settledVerb": "Read", "settledMessage": "C:/Github/ANYsolver/tests/test_beam_shell_workflow.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:/Github/ANYsolver/tests/test_beam_shell_workflow.py", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\tests\\test_beam_shell_workflow.py", "content": "\"\"\"Focused public workflow tests for the standalone beam-shell example.\n\nThese are integration tests of the registered pre-yield public workflow in\n``examples/beam_shell_coupling.py``: actual public solves for both coupling\nlaws, an independent true-elastic control, cooperative cancellation with and\nwithout accepted increments, and truthful CLI JSON/exit-status behaviour.\nThey are routine contract checks, not scientific qualification.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nimport runpy\n\nimport numpy as np\nimport pytest\n\nfrom anysolver import (\n    CancellationToken,\n    CoupledBeamShellElement,\n    InterpolatedBeamShellMPCElement,\n    solve_static_nonlinear,\n)\nfrom anysolver.elements import BeamElement\n\nEXAMPLE = Path(__file__).resolve().parents[1] / \"examples\" / \"beam_shell_coupling.py\"\n\n_CACHE: dict = {}\n\n\ndef _example_module():\n    return runpy.run_path(str(EXAMPLE))\n\n\ndef _cached_payload(coupling: str) -> dict:\n    if coupling not in _CACHE:\n        _CACHE[coupling] = _example_module()[\"run\"](coupling)\n    return _CACHE[coupling]\n\n\n@pytest.mark.parametrize(\"coupling\", (\"direct\", \"interpolated\"))\ndef test_build_model_registered_structure(coupling):\n    example = _example_module()\n    case = example[\"build_model\"](coupling)\n    model = case.model\n    elements = list(model.mesh.elements.values())\n    shells = [\n        e for e in elements\n        if not isinstance(e, (BeamElement, CoupledBeamShellElement,\n                             InterpolatedBeamShellMPCElement))\n    ]\n    assert len(shells) == 2\n    beams = [e for e in elements if isinstance(e, BeamElement)]\n    direct = [e for e in elements if isinstance(e, CoupledBeamShellElement)]\n    interpolated = [\n        e for e in elements if isinstance(e, InterpolatedBeamShellMPCElement)\n    ]\n    n_beam = 2 if coupling == \"direct\" else 3\n    assert len(beams) == n_beam\n    assert len(direct) + len(interpolated) == n_beam + 1\n    if coupling == \"direct\":\n        assert len(direct) == 3 and not interpolated\n        beam_x = sorted(float(model.mesh.nodes[n].x) for n in (100, 101, 102))\n        assert beam_x == [0.0, 0.5, 1.0]\n    else:\n        assert len(direct) == 2 and len(interpolated) == 2\n        beam_x = sorted(float(model.mesh.nodes[n].x) for n in (100, 101, 102, 103))\n        assert beam_x == [0.0, pytest.approx(1.0 / 3.0), pytest.approx(2.0 / 3.0), 1.0]\n        for element in interpolated:\n            weights = np.asarray(element.shape_weights, dtype=float)\n            assert len(element.shell_node_ids) == 2\n            assert float(weights.sum()) == pytest.approx(1.0)\n            assert np.all(weights > 0.0)\n    # Registered tip load: -2000 N uz on every shell-tip node, nothing else.\n    assert case.probe_node_id == 5\n    assert set(case.load.nodal_loads) == {5, 6}\n    for value in case.load.nodal_loads.values():\n        np.testing.assert_array_equal(value, [0.0, 0.0, -2000.0, 0.0, 0.0, 0.0])\n    # Registered material: canonical S355 curve with a hardening law.\n    material = model.get_material(\"steel\")\n    assert material.hardening_curve is not None\n    assert material.elastic_modulus == pytest.approx(2.1e11)\n    assert material.density == pytest.approx(7850.0)\n\n\n@pytest.mark.parametrize(\"coupling\", (\"direct\", \"interpolated\"))\ndef test_run_actual_public_solve_completed_payload(coupling):\n    payload = _cached_payload(coupling)\n    assert payload[\"coupling\"] == coupling\n    assert payload[\"status\"] == \"completed\"\n    assert payload[\"stop_reason\"] == \"target_load_factor_reached\"\n    assert payload[\"requested_load_factor\"] == 1.0\n    assert abs(payload[\"achieved_load_factor\"] - 1.0) <= 1.0e-8\n    assert payload[\"accepted_increments\"] == 6\n    postcheck = payload[\"constraint_postcheck\"]\n    assert postcheck[\"status\"] == \"passed\"\n    assert (\n        float(postcheck[\"max_relative_residual\"])\n        <= float(postcheck[\"relative_tolerance\"])\n    )\n    probe = payload[\"probe_displacement\"]\n    assert np.isfinite(probe) and probe < 0.0\n    assert payload[\"completed\"] is True\n    # The JSON document is serializable and keeps the same truth values.\n    round_trip = json.loads(json.dumps(payload))\n    assert round_trip[\"completed\"] is True\n    assert round_trip[\"status\"] == \"completed\"\n\n\ndef test_default_interpolated_probe_matches_true_elastic_control():\n    \"\"\"Independent control: a distinct linear-elastic material (no hardening\n    curve, same geometry and controls) must reproduce the default-coupling\n    probe displacement, which is only possible while the response is\n    genuinely pre-yield.\"\"\"\n    example = _example_module()\n    payload = _cached_payload(\"interpolated\")\n    case = example[\"build_model\"](\"interpolated\")\n    case.model.add_material(\"steel\", 2.1e11, 0.3, density=7850.0)\n    assert case.model.get_material(\"steel\").hardening_curve is None\n    result = solve_static_nonlinear(\n        case.model,\n        case.load,\n        kinematics=\"corotational\",\n        num_steps=example[\"NUM_STEPS\"],\n        max_iterations=example[\"MAX_ITERATIONS\"],\n        tolerance=example[\"TOLERANCE\"],\n    )\n    assert result.status == \"completed\"\n    dofs = case.model.mesh.dof_manager.get_node_dofs(case.probe_node_id)\n    elastic_probe = float(np.asarray(result.displacements)[dofs[2]])\n    relative_error = abs(payload[\"probe_displacement\"] - elastic_probe) / abs(\n        elastic_probe\n    )\n    assert relative_error <= 1.0e-7\n\n\ndef test_run_cancelled_before_any_increment_reports_empty_history():\n    example = _example_module()\n    token = CancellationToken()\n    token.cancel(\"cancelled before the solve starts\")\n    payload = example[\"run\"](\"direct\", cancellation_token=token)\n    assert payload[\"status\"] == \"cancelled\"\n    assert payload[\"stop_reason\"] == \"cancelled before the solve starts\"\n    assert payload[\"accepted_increments\"] == 0\n    assert payload[\"achieved_load_factor\"] is None\n    assert payload[\"probe_displacement\"] is None\n    assert payload[\"constraint_postcheck\"] is None\n    assert payload[\"completed\"] is False\n    assert json.loads(json.dumps(payload))[\"completed\"] is False\n\n\ndef test_run_solve_cancelled_after_accepted_increment_maps_to_noncompletion(monkeypatch):\n    \"\"\"run() must map an actual SolveCancelled raised after accepted\n    increments to non-completion JSON with the accepted history and no\n    success claim. (The registered force-controlled route itself only\n    checks cancellation at the solver start, so the mid-run exception is\n    injected at the example's own public solve entry point.)\"\"\"\n    from anysolver import SolveCancelled\n\n    example = _example_module()\n    run = example[\"run\"]\n\n    def fake_solve(model, load, **kwargs):\n        progress = kwargs[\"progress_callback\"]\n        progress({\n            \"event_type\": \"nonlinear_static_step\",\n            \"load_factor\": 1.0 / 6.0,\n        })\n        raise SolveCancelled(\"cancelled after one accepted increment\")\n\n    monkeypatch.setitem(run.__globals__, \"solve_static_nonlinear\", fake_solve)\n    payload = run(\"direct\", cancellation_token=CancellationToken())\n    assert payload[\"status\"] == \"cancelled\"\n    assert payload[\"stop_reason\"] == \"cancelled after one accepted increment\"\n    assert payload[\"accepted_increments\"] == 1\n    assert payload[\"achieved_load_factor\"] == pytest.approx(1.0 / 6.0)\n    assert payload[\"probe_displacement\"] is None\n    assert payload[\"constraint_postcheck\"] is None\n    assert payload[\"completed\"] is False\n    assert json.loads(json.dumps(payload))[\"completed\"] is False\n\n\ndef test_cli_stdout_json_exit_status_and_output_file(capsys, tmp_path):\n    scope = runpy.run_path(str(EXAMPLE))\n    main = scope[\"main\"]\n    completed_payload = {\n        \"coupling\": \"interpolated\",\n        \"status\": \"completed\",\n        \"stop_reason\": \"target_load_factor_reached\",\n        \"requested_load_factor\": 1.0,\n        \"achieved_load_factor\": 1.0,\n        \"probe_displacement\": -1.0e-3,\n        \"accepted_increments\": 6,\n        \"constraint_postcheck\": {\"status\": \"passed\"},\n        \"completed\": True,\n    }\n    stopped_payload = dict(completed_payload, status=\"stopped_at_limit\",\n                           completed=False, achieved_load_factor=0.5)\n    recorded = []\n\n    def fake_run(coupling=None, **kwargs):\n        recorded.append(coupling)\n        return completed_payload if len(recorded) == 1 else stopped_payload\n\n    # runpy.run_path returns a copy of the module namespace; main.__globals__\n    # is the live namespace the CLI actually reads.\n    main.__globals__[\"run\"] = fake_run\n    output_path = tmp_path / \"summary.json\"\n    assert main([\"--output\", str(output_path)]) == 0\n    first = json.loads(capsys.readouterr().out)\n    assert first == completed_payload\n    assert json.loads(output_path.read_text(encoding=\"utf-8\")) == completed_payload\n    assert main([\"--coupling\", \"direct\"]) == 1\n    second = json.loads(capsys.readouterr().out)\n    assert second == stopped_payload\n    assert recorded == [\"interpolated\", \"direct\"]\n\n\ndef test_cli_rejects_unknown_coupling():\n    scope = runpy.run_path(str(EXAMPLE))\n    with pytest.raises(SystemExit) as excinfo:\n        scope[\"main\"]([\"--coupling\", \"glued\"])\n    assert excinfo.value.code == 2\n", "numLines": 223, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "223 lines from C:\\Github\\ANYsolver\\tests\\test_beam_shell_workflow.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
