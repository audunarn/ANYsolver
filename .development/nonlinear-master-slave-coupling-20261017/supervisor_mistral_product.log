{"id": "effect-23d20928-423b-55d5-8fa6-c8cc2147c02c", "sessionId": "99df4bb9-552f-17e2-4fbf-9a21a62c2ae9", "turnId": "turn-929c7b13b199714ef5c9c40d2b9ebe6a", "createdAt": 1792347581289, "updatedAt": 1792347581374, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.bash", "detail": {"toolName": "file_system.bash", "display": {"summary": "bash: cd C:/Github/ANYsolver && sed -n '1281,1470p' src/anysolver/corotational.py", "content": null, "suffix": "", "verb": "Running", "message": "cd C:/Github/ANYsolver && sed -n '1281,1470p' src/anysolver/corotational.py", "settledVerb": "Ran", "settledMessage": "cd C:/Github/ANYsolver && sed -n '1281,1470p' src/anysolver/corotational.py", "statusText": "Running command"}, "kind": "shell", "input": {"command": "cd C:/Github/ANYsolver && sed -n '1281,1470p' src/anysolver/corotational.py"}}, "state": {"status": "completed", "output": {"stdout": "class NonlinearRotatingMPCMap:\n    \"\"\"State-dependent master-slave kinematic map for rotating eccentricities.\n\n    Given the reference linear constraint transformation ``T_linear`` (which\n    encodes ``u_b,lin = sum_i w_i u_{s,i} + theta_bar x r_0`` and\n    ``theta_b = theta_bar := sum_i w_i theta_{s,i}``), the nonlinear kinematic\n    map replaces the linearized lever-arm offset ``theta_bar x r_0`` with the\n    exact finite-rotation offset ``(R(theta_bar) - I) r_0``:\n\n        u_b(q)     = sum_i w_i u_{s,i}(q) + (R(theta_bar(q)) - I) r_0\n        theta_b(q) = theta_bar(q)\n\n    using zero Lagrange multipliers.\n    \"\"\"\n\n    def __init__(\n        self,\n        T_linear: Any,\n        entries: Tuple[NonlinearRotatingMPCEntry, ...],\n    ) -> None:\n        from scipy import sparse\n\n        self.T_linear = sparse.csr_matrix(T_linear, dtype=float)\n        self.entries = tuple(entries)\n        self.total_dofs = int(self.T_linear.shape[0])\n        self.n_red = int(self.T_linear.shape[1])\n\n    @property\n    def active(self) -> bool:\n        return bool(self.entries)\n\n    def apply_kinematics(self, u_linear: np.ndarray) -> np.ndarray:\n        \"\"\"Map a linear MPC displacement state ``u_lin`` to the nonlinear manifold.\"\"\"\n        u = np.asarray(u_linear, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return u\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u)\n            delta_R = _nonlinear_minus_linear_rotation(theta_bar)\n            u[entry.slave_u_dofs] = u[entry.slave_u_dofs] + delta_R @ entry.eccentricity\n        return u\n\n    def to_linear_displacement(self, u_nonlinear: np.ndarray) -> np.ndarray:\n        \"\"\"Exact inverse diffeomorphism mapping ``u`` back to linear MPC coordinates.\"\"\"\n        u_lin = np.asarray(u_nonlinear, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return u_lin\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u_lin)\n            delta_R = _nonlinear_minus_linear_rotation(theta_bar)\n            u_lin[entry.slave_u_dofs] = (\n                u_lin[entry.slave_u_dofs] - delta_R @ entry.eccentricity\n            )\n        return u_lin\n\n    def jacobian(self, u_current: np.ndarray) -> Any:\n        \"\"\"Return the state-dependent kinematic Jacobian ``J(u) = du / dq``.\"\"\"\n        from scipy import sparse\n\n        if not self.entries:\n            return self.T_linear\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        row_blocks = []\n        col_blocks = []\n        data_blocks = []\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            delta_A = A + entry.r_skew  # A(theta_bar, r_0) - (-skew(r_0))\n            corr = sparse.csr_matrix(delta_A) @ entry.theta_proj\n            coo = corr.tocoo()\n            if coo.nnz:\n                row_blocks.append(entry.slave_u_dofs[coo.row])\n                col_blocks.append(coo.col)\n                data_blocks.append(coo.data)\n        if not data_blocks:\n            return self.T_linear\n        delta_T = sparse.coo_matrix(\n            (\n                np.concatenate(data_blocks),\n                (np.concatenate(row_blocks), np.concatenate(col_blocks)),\n            ),\n            shape=(self.total_dofs, self.n_red),\n            dtype=float,\n        ).tocsr()\n        return (self.T_linear + delta_T).tocsr()\n\n    def reduce_force(self, u_current: np.ndarray, full_force: np.ndarray) -> np.ndarray:\n        \"\"\"Return ``J(u)^T full_force`` without materializing ``J(u)``.\"\"\"\n        f = np.asarray(full_force, dtype=float).reshape(-1)\n        if not self.entries:\n            return np.asarray(self.T_linear.T @ f, dtype=float).reshape(-1)\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        f_mod = f.copy()\n        for entry in self.entries:\n            f_b = f[entry.slave_u_dofs]\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\n                continue\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            delta_A = A + entry.r_skew\n            f_mod[entry.slave_theta_dofs] += delta_A.T @ f_b\n        return np.asarray(self.T_linear.T @ f_mod, dtype=float).reshape(-1)\n\n    def geometric_tangent(\n        self,\n        u_current: np.ndarray,\n        full_imbalance: np.ndarray,\n    ) -> Any:\n        \"\"\"Return ``K_mpc,geom(u, F_int - F_ext) = sum_b Theta_b^T H_b Theta_b``.\"\"\"\n        from scipy import sparse\n\n        if not self.entries or self.n_red == 0:\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1)\n        terms = []\n        for entry in self.entries:\n            if entry.theta_proj.nnz == 0:\n                continue\n            f_b = imbalance[entry.slave_u_dofs]\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\n                continue\n            theta_bar = entry.master_rotation(u)\n            H_b = rotating_mpc_geometric_hessian(\n                theta_bar, entry.eccentricity, f_b\n            )\n            terms.append(entry.theta_proj.T @ sparse.csr_matrix(H_b) @ entry.theta_proj)\n        if not terms:\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\n        total = terms[0]\n        for term in terms[1:]:\n            total = total + term\n        return total.tocsr()\n\n    def reduce_tangent(\n        self,\n        u_current: np.ndarray,\n        K_T: Any,\n        full_imbalance: Optional[np.ndarray] = None,\n        K_ext: Optional[Any] = None,\n    ) -> Any:\n        \"\"\"Return ``J(u)^T (K_T - K_ext) J(u) + K_mpc,geom(u, full_imbalance)``.\"\"\"\n        J = self.jacobian(u_current)\n        K_red = (J.T @ K_T @ J).tocsr()\n        if K_ext is not None and getattr(K_ext, \"nnz\", 0):\n            K_red = (K_red - (J.T @ K_ext @ J)).tocsr()\n        if full_imbalance is not None:\n            K_geom = self.geometric_tangent(u_current, full_imbalance)\n            if K_geom.nnz:\n                K_red = (K_red + K_geom).tocsr()\n        return K_red\n\n    def transfer_slave_imbalance_to_masters(\n        self,\n        u_current: np.ndarray,\n        full_imbalance: np.ndarray,\n    ) -> np.ndarray:\n        \"\"\"Transfer slave forces/moments to master shell DOFs for support reactions.\"\"\"\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return imbalance\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        for entry in self.entries:\n            f_b = imbalance[entry.slave_u_dofs].copy()\n            m_b = imbalance[entry.slave_theta_dofs].copy()\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            moment_covector = m_b + A.T @ f_b\n            for m_u, m_theta, w in entry.masters:\n                imbalance[m_u] += w * f_b\n                imbalance[m_theta] += w * moment_covector\n            imbalance[entry.slave_u_dofs] = 0.0\n            imbalance[entry.slave_theta_dofs] = 0.0\n        return imbalance\n\n\ndef has_nonlinear_rotating_mpc(model: \"FEModel\") -> bool:\n    \"\"\"Return True if ``model`` contains active rotating-arm beam-shell MPCs.\"\"\"\n    mesh = getattr(model, \"mesh\", None)\n    elements = getattr(mesh, \"elements\", None)\n    if not elements:\n        return False\n    for element in elements.values():\n        getter = getattr(element, \"get_nonlinear_mpc_descriptor\", None)\n        if callable(getter) and getter(mesh) is not None:\n            return True\n    return False\n\n\n", "stderr": "", "output": "", "truncated": false}, "outputText": "class NonlinearRotatingMPCMap:\n    \"\"\"State-dependent master-slave kinematic map for rotating eccentricities.\n\n    Given the reference linear constraint transformation ``T_linear`` (which\n    encodes ``u_b,lin = sum_i w_i u_{s,i} + theta_bar x r_0`` and\n    ``theta_b = theta_bar := sum_i w_i theta_{s,i}``), the nonlinear kinematic\n    map replaces the linearized lever-arm offset ``theta_bar x r_0`` with the\n    exact finite-rotation offset ``(R(theta_bar) - I) r_0``:\n\n        u_b(q)     = sum_i w_i u_{s,i}(q) + (R(theta_bar(q)) - I) r_0\n        theta_b(q) = theta_bar(q)\n\n    using zero Lagrange multipliers.\n    \"\"\"\n\n    def __init__(\n        self,\n        T_linear: Any,\n        entries: Tuple[NonlinearRotatingMPCEntry, ...],\n    ) -> None:\n        from scipy import sparse\n\n        self.T_linear = sparse.csr_matrix(T_linear, dtype=float)\n        self.entries = tuple(entries)\n        self.total_dofs = int(self.T_linear.shape[0])\n        self.n_red = int(self.T_linear.shape[1])\n\n    @property\n    def active(self) -> bool:\n        return bool(self.entries)\n\n    def apply_kinematics(self, u_linear: np.ndarray) -> np.ndarray:\n        \"\"\"Map a linear MPC displacement state ``u_lin`` to the nonlinear manifold.\"\"\"\n        u = np.asarray(u_linear, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return u\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u)\n            delta_R = _nonlinear_minus_linear_rotation(theta_bar)\n            u[entry.slave_u_dofs] = u[entry.slave_u_dofs] + delta_R @ entry.eccentricity\n        return u\n\n    def to_linear_displacement(self, u_nonlinear: np.ndarray) -> np.ndarray:\n        \"\"\"Exact inverse diffeomorphism mapping ``u`` back to linear MPC coordinates.\"\"\"\n        u_lin = np.asarray(u_nonlinear, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return u_lin\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u_lin)\n            delta_R = _nonlinear_minus_linear_rotation(theta_bar)\n            u_lin[entry.slave_u_dofs] = (\n                u_lin[entry.slave_u_dofs] - delta_R @ entry.eccentricity\n            )\n        return u_lin\n\n    def jacobian(self, u_current: np.ndarray) -> Any:\n        \"\"\"Return the state-dependent kinematic Jacobian ``J(u) = du / dq``.\"\"\"\n        from scipy import sparse\n\n        if not self.entries:\n            return self.T_linear\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        row_blocks = []\n        col_blocks = []\n        data_blocks = []\n        for entry in self.entries:\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            delta_A = A + entry.r_skew  # A(theta_bar, r_0) - (-skew(r_0))\n            corr = sparse.csr_matrix(delta_A) @ entry.theta_proj\n            coo = corr.tocoo()\n            if coo.nnz:\n                row_blocks.append(entry.slave_u_dofs[coo.row])\n                col_blocks.append(coo.col)\n                data_blocks.append(coo.data)\n        if not data_blocks:\n            return self.T_linear\n        delta_T = sparse.coo_matrix(\n            (\n                np.concatenate(data_blocks),\n                (np.concatenate(row_blocks), np.concatenate(col_blocks)),\n            ),\n            shape=(self.total_dofs, self.n_red),\n            dtype=float,\n        ).tocsr()\n        return (self.T_linear + delta_T).tocsr()\n\n    def reduce_force(self, u_current: np.ndarray, full_force: np.ndarray) -> np.ndarray:\n        \"\"\"Return ``J(u)^T full_force`` without materializing ``J(u)``.\"\"\"\n        f = np.asarray(full_force, dtype=float).reshape(-1)\n        if not self.entries:\n            return np.asarray(self.T_linear.T @ f, dtype=float).reshape(-1)\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        f_mod = f.copy()\n        for entry in self.entries:\n            f_b = f[entry.slave_u_dofs]\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\n                continue\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            delta_A = A + entry.r_skew\n            f_mod[entry.slave_theta_dofs] += delta_A.T @ f_b\n        return np.asarray(self.T_linear.T @ f_mod, dtype=float).reshape(-1)\n\n    def geometric_tangent(\n        self,\n        u_current: np.ndarray,\n        full_imbalance: np.ndarray,\n    ) -> Any:\n        \"\"\"Return ``K_mpc,geom(u, F_int - F_ext) = sum_b Theta_b^T H_b Theta_b``.\"\"\"\n        from scipy import sparse\n\n        if not self.entries or self.n_red == 0:\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1)\n        terms = []\n        for entry in self.entries:\n            if entry.theta_proj.nnz == 0:\n                continue\n            f_b = imbalance[entry.slave_u_dofs]\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\n                continue\n            theta_bar = entry.master_rotation(u)\n            H_b = rotating_mpc_geometric_hessian(\n                theta_bar, entry.eccentricity, f_b\n            )\n            terms.append(entry.theta_proj.T @ sparse.csr_matrix(H_b) @ entry.theta_proj)\n        if not terms:\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\n        total = terms[0]\n        for term in terms[1:]:\n            total = total + term\n        return total.tocsr()\n\n    def reduce_tangent(\n        self,\n        u_current: np.ndarray,\n        K_T: Any,\n        full_imbalance: Optional[np.ndarray] = None,\n        K_ext: Optional[Any] = None,\n    ) -> Any:\n        \"\"\"Return ``J(u)^T (K_T - K_ext) J(u) + K_mpc,geom(u, full_imbalance)``.\"\"\"\n        J = self.jacobian(u_current)\n        K_red = (J.T @ K_T @ J).tocsr()\n        if K_ext is not None and getattr(K_ext, \"nnz\", 0):\n            K_red = (K_red - (J.T @ K_ext @ J)).tocsr()\n        if full_imbalance is not None:\n            K_geom = self.geometric_tangent(u_current, full_imbalance)\n            if K_geom.nnz:\n                K_red = (K_red + K_geom).tocsr()\n        return K_red\n\n    def transfer_slave_imbalance_to_masters(\n        self,\n        u_current: np.ndarray,\n        full_imbalance: np.ndarray,\n    ) -> np.ndarray:\n        \"\"\"Transfer slave forces/moments to master shell DOFs for support reactions.\"\"\"\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1).copy()\n        if not self.entries:\n            return imbalance\n        u = np.asarray(u_current, dtype=float).reshape(-1)\n        for entry in self.entries:\n            f_b = imbalance[entry.slave_u_dofs].copy()\n            m_b = imbalance[entry.slave_theta_dofs].copy()\n            theta_bar = entry.master_rotation(u)\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n            moment_covector = m_b + A.T @ f_b\n            for m_u, m_theta, w in entry.masters:\n                imbalance[m_u] += w * f_b\n                imbalance[m_theta] += w * moment_covector\n            imbalance[entry.slave_u_dofs] = 0.0\n            imbalance[entry.slave_theta_dofs] = 0.0\n        return imbalance\n\n\ndef has_nonlinear_rotating_mpc(model: \"FEModel\") -> bool:\n    \"\"\"Return True if ``model`` contains active rotating-arm beam-shell MPCs.\"\"\"\n    mesh = getattr(model, \"mesh\", None)\n    elements = getattr(mesh, \"elements\", None)\n    if not elements:\n        return False\n    for element in elements.values():\n        getter = getattr(element, \"get_nonlinear_mpc_descriptor\", None)\n        if callable(getter) and getter(mesh) is not None:\n            return True\n    return False\n\n\n", "durationMs": 0.0, "display": {"success": true, "verb": "Ran", "message": "cd C:/Github/ANYsolver && sed -n '1281,1470p' src/anysolver/corotational.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
