n    )\n    dof_manager = model.mesh.dof_manager\n    balance = np.zeros(6, dtype=float)\n    applied = np.zeros(6, dtype=float)\n    for node in model.mesh.nodes.values():\n        dofs = dof_manager.get_node_dofs(node.id)\n        position = np.array([node.x, node.y, node.z], dtype=float)\n        force = imbalance[dofs[:3]]\n        moment = imbalance[dofs[3:6]]\n        balance[:3] += force\n        balance[3:] += np.cross(position, force) + moment\n        load_force = np.asarray(F_prop)[dofs[:3]]\n        load_moment = np.asarray(F_prop)[dofs[3:6]]\n        applied[:3] += lam * load_force\n        applied[3:] += lam * (np.cross(position, load_force) + load_moment)\n    balance = balance + applied\n    return {\n        \"relative_residual\": relative,\n        \"balance\": balance,\n        \"applied_wrench\": applied,\n    }", "newText": "def _independent_equilibrium(case: dict) -> dict:\n    \"\"\"Residual at the achieved load factor plus explicit force/wrench balance.\n\n    The reduced residual is reconstructed independently of the solver's own\n    convergence bookkeeping: J(u)^T (f_int(u, states) - lam * F_prop) relative\n    to J(u)^T F_prop.  The wrench balance is the physical support equilibrium:\n    root-node residuals after rotating slave imbalance transfer, with\n    deformed force arms and spatial moments (root rotations are zero, so the\n    moment covectors are spatial moments), against the applied tip loads at\n    their actual deformed loaded nodes.\n    \"\"\"\n    model, load = case[\"model\"], case[\"load\"]\n    result = case[\"result\"]\n    grid = case[\"grid\"]\n    u = np.asarray(result.displacements, dtype=float)\n    lam = float(result.load_factor)\n    states = copy.deepcopy(dict(result.element_states))\n    K0, _ = assemble_stiffness_matrix(model)\n    F_prop, _ = assemble_load_vector(model, load)\n    _, _, T, _u0, _, _ = build_constraint_transformation(K0, F_prop, model)\n    mpc_map = build_nonlinear_rotating_mpc_map(model, T)\n    assert mpc_map is not None and mpc_map.active\n    f_int, _, _ = _assemble_nonlinear_system(\n        model, u, states, 5, tangent=False, kinematics=\"corotational\",\n        corotational_tangent=\"work_conjugate\",\n    )\n    reduced = mpc_map.reduce_force(u, f_int - lam * F_prop)\n    reference = mpc_map.reduce_force(u, F_prop)\n    relative = float(np.linalg.norm(reduced)) / max(\n        float(np.linalg.norm(reference)), 1.0\n    )\n    imbalance = np.asarray(f_int, dtype=float) - lam * np.asarray(\n        F_prop, dtype=float\n    )\n    imbalance = mpc_map.transfer_slave_imbalance_to_masters(u, imbalance)\n    dof_manager = model.mesh.dof_manager\n    nodes = model.mesh.nodes\n\n    def deformed_position(node_id: int) -> np.ndarray:\n        node = nodes[node_id]\n        dofs = dof_manager.get_node_dofs(node_id)\n        return np.array([\n            node.x + u[dofs[0]],\n            node.y + u[dofs[1]],\n            node.z + u[dofs[2]],\n        ], dtype=float)\n\n    support = np.zeros(6, dtype=float)\n    for iy in range(NY + 1):\n        dofs = dof_manager.get_node_dofs(grid[(0, iy)])\n        force = imbalance[dofs[:3]]\n        moment = imbalance[dofs[3:6]]\n        support[:3] += force\n        support[3:] += np.cross(deformed_position(grid[(0, iy)]), force) + moment\n    applied = np.zeros(6, dtype=float)\n    for iy in range(NY + 1):\n        node_id = grid[(NX, iy)]\n        dofs = dof_manager.get_node_dofs(node_id)\n        force = lam * np.asarray(F_prop, dtype=float)[dofs[:3]]\n        moment = lam * np.asarray(F_prop, dtype=float)[dofs[3:6]]\n        applied[:3] += force\n        applied[3:] += np.cross(deformed_position(node_id), force) + moment\n    balance = support + applied\n    return {\n        \"relative_residual\": relative,\n        \"balance\": balance,\n        \"support_wrench\": support,\n        \"applied_wrench\": applied,\n    }"}]}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Edited", "message": "C:\\Github\\ANYsolver\\tests\\test_nonlinear_beam_shell_slice3_continuation.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
