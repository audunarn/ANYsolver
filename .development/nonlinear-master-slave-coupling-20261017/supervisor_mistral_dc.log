7108494833, \"columns\": [{\"column\": 14, \"relative_error\": 1.9999999999814553}, {\"column\": 15, \"relative_error\": 1.9999999999713178}, {\"column\": 23, \"relative_error\": 1.999999999998481}, {\"column\": 20, \"relative_error\": 1.9999999999543432}], \"kred_smallest_singular_values\": [80863.6030749123, 42476.967321067925, 27020.007979746708, 14357.308890355978], \"kred_largest_singular_value\": 8488416699.615674}\r\n{\"stage\": \"augmented\", \"tag\": \"terminal\", \"aug_smallest_singular_values\": [42490.04725228432, 27022.319180227547, 14365.070730849897, 0.01059206457439015], \"aug_largest_singular_value\": 8488416699.615674, \"tiny_step_dq_norm\": 0.00026641944764223155, \"tiny_step_dlam\": -0.006140727268927975, \"tiny_step_trial_residual\": 6.35197878388043, \"tiny_step_trial_uz\": -0.1832682291666667}\r\n", "durationMs": 0.0, "display": {"success": true, "verb": "Ran", "message": "cd \"C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/evidence/ep-dc-block-probe-direct-1\" && cat stdout.txt", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
