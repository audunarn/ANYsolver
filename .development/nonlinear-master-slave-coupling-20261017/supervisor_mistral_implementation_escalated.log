upling, float(scale))\n    add_tip_load(m, lc, -2000.0)\n    kwargs = dict(kinematics=\"corotational\", **FC_PARAMS, emit_restart_checkpoint=True)\n    if control_name == \"dc\":\n        kwargs.update(\n            control=\"displacement\",\n            displacement_control=DisplacementControl(node_id=probe, dof=\"uz\", target_displacement=-0.02),\n            **{k: v for k, v in DC_PARAMS.items() if k != \"num_steps\"},\n            num_steps=4,\n        )\n    try:\n        res = solve_static_nonlinear(m, lc, **kwargs)\n        report = {\"stage\": \"ckpt_probe\", \"coupling\": coupling, \"control\": control_name,\n                  \"scale\": float(scale), \"status\": res.status,\n                  \"checkpoint_emitted\": res.restart_checkpoint is not None}\n    except Exception as exc:  # noqa: BLE001\n        report = {\"stage\": \"ckpt_probe\", \"coupling\": coupling, \"control\": control_name,\n                  \"scale\": float(scale), \"error\": f\"{type(exc).__name__}: {str(exc)[:200]}\"}\n    print(json.dumps(report), flush=True)\n\n\ndef main():\n    stage = sys.argv[1]\n    if stage == \"preyield\":\n        stage_preyield()\n    elif stage == \"dc_full\":\n        stage_dc_full(sys.argv[2])\n    elif stage == \"dc_split\":\n        stage_dc_split(sys.argv[2])\n    elif stage == \"dc_cancel\":\n        stage_dc_cancel(sys.argv[2])\n    elif stage == \"ckpt_probe\":\n        stage_ckpt_probe(sys.argv[2], sys.argv[3], sys.argv[4])\n    else:\n        raise SystemExit(f\"unknown stage {stage!r}\")"}]}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Edited", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_edge_coupling.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
