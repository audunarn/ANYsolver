{"id": "effect-c2cac5fc-0ed5-52cc-a6e4-67395c495d42", "sessionId": "b9a80757-48a2-a90d-2f72-692761706b93", "turnId": "turn-8c7e0354138e253f073f636b837c66de", "createdAt": 1792345706940, "updatedAt": 1792345706975, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.write_file", "detail": {"toolName": "file_system.write_file", "display": {"summary": "Writing C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "content": "\"\"\"Slice 3 task harness: bounded, evidenced numerical execution.\n\nUsage (from anywhere):\n  <repo>/.venv/Scripts/python.exe harness.py --name ATTEMPT [--timeout 120]\n      [--cwd DIR] [--allow-reserve] [--hash-input PATH]... -- CMD ARGS...\n\nRecords under evidence/<name>/:\n  receipt.json  command, cwd, hashes, runtime record, exit/timeout status,\n                precise process-wall seconds, cumulative budget, counts\n  preflight.json  effective versions, import origins, threadpool, JIT\n  stdout.txt / stderr.txt  full streamed output (preserved on timeout)\n  running.json  live lock record (removed on completion)\n\nBudget ledger persists in budget.json (allowance 3600 s, final-verification\nreserve 900 s). Every attempt, including failures and timeouts, is charged.\nOne numerical child at a time is enforced with a lock file.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nTASK_DIR = Path(__file__).resolve().parent\nREPO = TASK_DIR.parents[1]\nEVIDENCE = TASK_DIR / \"evidence\"\nBUDGET_FILE = TASK_DIR / \"budget.json\"\nLOCK_FILE = TASK_DIR / \"running.lock\"\nALLOWANCE = 3600.0\nRESERVE = 900.0\n\nIDENTITY_FILES = [\n    \"src/anysolver/corotational.py\",\n    \"src/anysolver/elements.py\",\n    \"src/anysolver/mesh_gen.py\",\n    \"src/anysolver/nonlinear_static.py\",\n    \"src/anysolver/nonlinear_performance.py\",\n    \"tests/test_corotational_work_conjugate.py\",\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\n]\n\nCHILD_ENV = {\n    \"OMP_NUM_THREADS\": \"1\",\n    \"OPENBLAS_NUM_THREADS\": \"1\",\n    \"MKL_NUM_THREADS\": \"1\",\n    \"NUMEXPR_NUM_THREADS\": \"1\",\n    \"NUMBA_NUM_THREADS\": \"1\",\n    \"NUMBA_DISABLE_JIT\": \"1\",\n    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n    \"PYTHONHASHSEED\": \"0\",\n    \"PYTHONNOUSERSITE\": \"1\",\n    \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\": \"1\",\n    \"ANYSOLVER_RUN_RETIRED_PROGRAMME_TESTS\": \"0\",\n}\n\nPREFLIGHT_CODE = r\"\"\"\nimport json, sys\ninfo = {\"python\": sys.version}\ntry:\n    import numpy, scipy\n    info[\"numpy\"] = numpy.__version__\n    info[\"scipy\"] = scipy.__version__\nexcept Exception as exc:\n    info[\"numpy_error\"] = repr(exc)\nfor name in (\"anysolver\", \"anymaterial\", \"anygeometry\", \"anymesher\", \"anyfileio\"):\n    try:\n        mod = __import__(name)\n        info[name] = {\n            \"version\": getattr(mod, \"__version__\", None),\n            \"origin\": getattr(mod, \"__file__\", None),\n        }\n    except Exception as exc:\n        info[name] = {\"error\": repr(exc)}\ntry:\n    import numba\n    info[\"numba\"] = numba.__version__\nexcept Exception as exc:\n    info[\"numba\"] = None\ntry:\n    from threadpoolctl import threadpool_info\n    info[\"threadpools\"] = threadpool_info()\nexcept Exception:\n    info[\"threadpools\"] = \"unavailable\"\nprint(json.dumps(info))\n\"\"\"\n\nCOUNT_PATTERNS = [\n    (re.compile(r\"(\\d+) passed(?:,\\s*(\\d+) skipped)?(?:,\\s*(\\d+) failed)?\"), \"pytest\"),\n    (re.compile(r\"(\\d+) failed(?:,\\s*(\\d+) passed)?\"), \"pytest_failed_first\"),\n]\n\n\ndef sha256_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef load_budget() -> dict:\n    if BUDGET_FILE.exists():\n        with open(BUDGET_FILE, \"r\", encoding=\"utf-8\") as fh:\n            return json.load(fh)\n    return {\n        \"allowance_seconds\": ALLOWANCE,\n        \"final_verification_reserve_seconds\": RESERVE,\n        \"used_seconds\": 0.0,\n        \"attempts\": [],\n    }\n\n\ndef save_budget(budget: dict) -> None:\n    with open(BUDGET_FILE, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(budget, fh, indent=2)\n\n\ndef parse_counts(stdout: str) -> dict:\n    counts = {}\n    for pattern in COUNT_PATTERNS:\n        match = pattern[0].search(stdout)\n        if match:\n            groups = [g for g in match.groups() if g is not None]\n            counts[pattern[1]] = [int(g) for g in groups]\n            break\n    return counts\n\n\ndef kill_tree(pid: int) -> None:\n    subprocess.run(\n        [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\n        capture_output=True,\n        check=False,\n    )\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--timeout\", type=float, default=120.0)\n    parser.add_argument(\"--cwd\", default=str(REPO))\n    parser.add_argument(\"--allow-reserve\", action=\"store_true\")\n    parser.add_argument(\"--hash-input\", action=\"append\", default=[])\n    parser.add_argument(\"--skip-preflight\", action=\"store_true\")\n    parser.add_argument(\"command\", nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n\n    if args.command and args.command[0] == \"--\":\n        args.command = args.command[1:]\n    if not args.command:\n        parser.error(\"no command given\")\n\n    budget = load_budget()\n    used = float(budget[\"used_seconds\"])\n    remaining = ALLOWANCE - used\n    available = remaining - RESERVE\n    if not args.allow_reserve and args.timeout > available:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds available non-reserve \"\n            f\"budget {available:.1f}s (used {used:.1f}s of {ALLOWANCE}s, \"\n            f\"reserve {RESERVE}s). Use --allow-reserve only for final verification.\",\n            file=sys.stderr,\n        )\n        return 2\n    if args.timeout > remaining:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds total remaining {remaining:.1f}s.\",\n            file=sys.stderr,\n        )\n        return 2\n\n    if LOCK_FILE.exists():\n        try:\n            live = json.loads(LOCK_FILE.read_text(encoding=\"utf-8\"))\n        except Exception:\n            live = None\n        print(\n            f\"REFUSED: another numerical child appears active (lock: {live}).\",\n            file=sys.stderr,\n        )\n        return 3\n\n    out_dir = EVIDENCE / args.name\n    if out_dir.exists():\n        print(f\"REFUSED: evidence path {out_dir} already exists.\", file=sys.stderr)\n        return 4\n    out_dir.mkdir(parents=True)\n\n    LOCK_FILE.write_text(\n        json.dumps({\"name\": args.name, \"pid\": os.getpid(), \"started_utc\": datetime.now(timezone.utc).isoformat()}),\n        encoding=\"utf-8\",\n    )\n\n    env = dict(os.environ)\n    env.update(CHILD_ENV)\n    src = str(REPO / \"src\")\n    env[\"PYTHONPATH\"] = src + os.pathsep + env.get(\"PYTHONPATH\", \"\")\n\n    hashes = {rel: sha256_file(REPO / rel) for rel in IDENTITY_FILES}\n    for extra in args.hash_input:\n        p = Path(extra)\n        hashes[str(p)] = sha256_file(p) if p.exists() else \"MISSING\"\n\n    started_utc = datetime.now(timezone.utc).isoformat()\n    wall_total = 0.0\n    status = \"ERROR\"\n    exit_code = None\n    preflight = None\n\n    try:\n        if not args.skip_preflight:\n            pre_out = out_dir / \"preflight_stdout.txt\"\n            t0 = time.perf_counter()\n            with open(pre_out, \"wb\") as fh:\n                proc = subprocess.Popen(\n                    [sys.executable, \"-c\", PREFLIGHT_CODE],\n                    stdout=fh, stderr=subprocess.PIPE, env=env, cwd=args.cwd,\n                )\n                _, pre_err = proc.communicate(timeout=max(10.0, args.timeout))\n            pre_wall = time.perf_counter() - t0\n            wall_total += pre_wall\n            preflight = {\n                \"wall_seconds\": pre_wall,\n                \"exit_code\": proc.returncode,\n                \"stderr\": pre_err.decode(\"utf-8\", \"replace\")[-4000:],\n            }\n            try:\n                preflight[\"runtime\"] = json.loads(pre_out.read_text(encoding=\"utf-8\"))\n            except Exception as exc:\n                preflight[\"runtime_parse_error\"] = repr(exc)\n            (out_dir / \"preflight.json\").write_text(\n                json.dumps(preflight, indent=2), encoding=\"utf-8\"\n            )\n\n        stdout_path = out_dir / \"stdout.txt\"\n        stderr_path = out_dir / \"stderr.txt\"\n        t0 = time.perf_counter()\n        with open(stdout_path, \"wb\") as out_fh, open(stderr_path, \"wb\") as err_fh:\n            proc = subprocess.Popen(\n                args.command,\n                stdout=out_fh, stderr=err_fh,\n                env=env, cwd=args.cwd,\n            )\n            try:\n                proc.wait(timeout=max(1.0, args.timeout - wall_total))\n                status = \"EXIT\" if proc.returncode == 0 else f\"EXIT_{proc.returncode}\"\n                exit_code = proc.returncode\n            except subprocess.TimeoutExpired:\n                kill_tree(proc.pid)\n                try:\n                    proc.wait(timeout=30)\n                except subprocess.TimeoutExpired:\n                    pass\n                status = \"TIMEOUT\"\n                exit_code = proc.returncode\n        main_wall = time.perf_counter() - t0\n        wall_total += main_wall\n\n        stdout_text = stdout_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n        receipt = {\n            \"name\": args.name,\n            \"command\": args.command,\n            \"cwd\": str(Path(args.cwd)),\n            \"started_utc\": started_utc,\n            \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n            \"status\": status,\n            \"exit_code\": exit_code,\n            \"timeout_seconds\": args.timeout,\n            \"process_wall_seconds\": wall_total,\n            \"main_wall_seconds\": main_wall,\n            \"identity_hashes\": hashes,\n            \"child_env\": CHILD_ENV,\n            \"preflight_included\": preflight is not None,\n            \"counts\": parse_counts(stdout_text),\n            \"head\": subprocess.run(\n                [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                capture_output=True, text=True,\n            ).stdout.strip(),\n        }\n        (out_dir / \"receipt.json\").write_text(\n            json.dumps(receipt, indent=2), encoding=\"utf-8\"\n        )\n\n        budget[\"used_seconds\"] = used + wall_total\n        budget[\"attempts\"].append({\n            \"name\": args.name,\n            \"status\": status,\n            \"wall_seconds\": wall_total,\n            \"cumulative_used\": budget[\"used_seconds\"],\n            \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n            \"started_utc\": started_utc,\n        })\n        save_budget(budget)\n        print(\n            f\"[harness] {args.name}: {status} wall={wall_total:.2f}s \"\n            f\"used={budget['used_seconds']:.1f}s remaining={ALLOWANCE - budget['used_seconds']:.1f}s\"\n        )\n        return 0 if status == \"EXIT\" else 1\n    finally:\n        try:\n            LOCK_FILE.unlink()\n        except FileNotFoundError:\n            pass\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "suffix": "", "verb": "Creating", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "settledVerb": "Created", "settledMessage": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "statusText": "Writing file"}, "kind": "file_write", "input": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "content": "\"\"\"Slice 3 task harness: bounded, evidenced numerical execution.\n\nUsage (from anywhere):\n  <repo>/.venv/Scripts/python.exe harness.py --name ATTEMPT [--timeout 120]\n      [--cwd DIR] [--allow-reserve] [--hash-input PATH]... -- CMD ARGS...\n\nRecords under evidence/<name>/:\n  receipt.json  command, cwd, hashes, runtime record, exit/timeout status,\n                precise process-wall seconds, cumulative budget, counts\n  preflight.json  effective versions, import origins, threadpool, JIT\n  stdout.txt / stderr.txt  full streamed output (preserved on timeout)\n  running.json  live lock record (removed on completion)\n\nBudget ledger persists in budget.json (allowance 3600 s, final-verification\nreserve 900 s). Every attempt, including failures and timeouts, is charged.\nOne numerical child at a time is enforced with a lock file.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nTASK_DIR = Path(__file__).resolve().parent\nREPO = TASK_DIR.parents[1]\nEVIDENCE = TASK_DIR / \"evidence\"\nBUDGET_FILE = TASK_DIR / \"budget.json\"\nLOCK_FILE = TASK_DIR / \"running.lock\"\nALLOWANCE = 3600.0\nRESERVE = 900.0\n\nIDENTITY_FILES = [\n    \"src/anysolver/corotational.py\",\n    \"src/anysolver/elements.py\",\n    \"src/anysolver/mesh_gen.py\",\n    \"src/anysolver/nonlinear_static.py\",\n    \"src/anysolver/nonlinear_performance.py\",\n    \"tests/test_corotational_work_conjugate.py\",\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\n]\n\nCHILD_ENV = {\n    \"OMP_NUM_THREADS\": \"1\",\n    \"OPENBLAS_NUM_THREADS\": \"1\",\n    \"MKL_NUM_THREADS\": \"1\",\n    \"NUMEXPR_NUM_THREADS\": \"1\",\n    \"NUMBA_NUM_THREADS\": \"1\",\n    \"NUMBA_DISABLE_JIT\": 