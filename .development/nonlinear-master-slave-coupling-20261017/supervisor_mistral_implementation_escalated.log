{"id": "effect-ec7faa2c-3b85-595d-8e16-9e359820bdd0", "sessionId": "b9a80757-48a2-a90d-2f72-692761706b93", "turnId": "turn-8c7e0354138e253f073f636b837c66de", "createdAt": 1792345661846, "updatedAt": 1792345661874, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "settledVerb": "Read", "settledMessage": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "content": "\"\"\"Isolate the 'plastic stiffer than elastic' anomaly.\n\nMatrix: {shell_only, coupled} x {corotational, von_karman} x {elastic(yield x1e4), plastic}\nPlus beam-only fiber cantilever (no shell) to isolate the fiber section.\n\"\"\"\nimport sys\nimport numpy as np\nfrom anymaterial import DNVC208MaterialCurve\nfrom anysolver import BoundaryCondition, FEModel, LoadCase, create_shell_element, solve_static_nonlinear\nfrom anysolver.elements import BeamElement, CoupledBeamShellElement\n\nL, W, t = 1.0, 0.24, 0.012\nNX, NY = 2, 1\nR = np.array([0.0, 0.0, 0.04])\nCS = {\"area\": 4e-4, \"Iy\": 0.01 * 0.04**3 / 12, \"Iz\": 0.04 * 0.01**3 / 12,\n      \"J\": 1e-8, \"b\": 0.01, \"h\": 0.04, \"fiber_plasticity\": True}\n\n\ndef material(model, scale):\n    from anysolver.material_curves import DNVC208MaterialCurve as C, dnv_c208_steel_curve\n    base = dnv_c208_steel_curve(\"S355\", 0.012).as_dict()\n    hc = C(base[\"sigma_prop\"] * scale, base[\"sigma_yield\"] * scale, base[\"sigma_yield_2\"] * scale,\n           base[\"eps_p_y1\"], base[\"eps_p_y2\"], base[\"K\"] * scale, base[\"n\"])\n    model.add_material(\"steel\", 2.1e11, 0.3, density=7850.0,\n                       yield_stress=base[\"sigma_yield\"] * scale, hardening_curve=hc)\n\n\ndef shell_model(scale, coupled, fz):\n    m = FEModel(\"iso\")\n    material(m, scale)\n    grid = {}\n    nid = 1\n    for ix, x in enumerate(np.linspace(0, L, NX + 1)):\n        for iy, y in enumerate(np.linspace(-W / 2, W / 2, NY + 1)):\n            m.add_node(nid, float(x), float(y), 0.0)\n            grid[(ix, iy)] = nid\n            nid += 1\n    eid = 1\n    for ix in range(NX):\n        for iy in range(NY):\n            m.add_element(eid, create_shell_element(\n                eid, [grid[(ix, iy)], grid[(ix + 1, iy)], grid[(ix + 1, iy + 1)], grid[(ix, iy + 1)]],\n                \"steel\", thickness=t))\n            eid += 1\n    probe = grid[(NX, 0)]\n    if coupled:\n        bn = []\n        for ix in range(NX + 1):\n            b = 100 + ix\n            mid = grid[(ix, 0)]\n            mn = m.mesh.get_node(mid)\n            m.add_node(b, mn.x, mn.y, mn.z + R[2])\n            bn.append(b)\n            m.add_element(200 + ix, CoupledBeamShellElement(200 + ix, b, mid, \"steel\", eccentricity=R))\n        for ix in range(NX):\n            m.add_element(300 + ix, BeamElement(300 + ix, [bn[ix], bn[ix + 1]], \"steel\", dict(CS)))\n    m.add_boundary_condition(BoundaryCondition(\n        \"root\", [grid[(0, iy)] for iy in range(NY + 1)],\n        {k: 0.0 for k in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")}))\n    m.apply_boundary_conditions()\n    lc = LoadCase(\"tip\")\n    for iy in range(NY + 1):\n        lc.add_nodal_load(grid[(NX, iy)], [0, 0, fz, 0, 0, 0])\n    m.add_load_case(lc)\n    return m, lc, probe\n\n\ndef beam_model(scale, fz):\n    m = FEModel(\"beam\")\n    material(m, scale)\n    n = 4\n    for i in range(n + 1):\n        m.add_node(1 + i, L * i / n, 0.0, 0.0)\n    for i in range(n):\n        m.add_element(10 + i, BeamElement(10 + i, [1 + i, 2 + i], \"steel\", dict(CS)))\n    m.add_boundary_condition(BoundaryCondition(\n        \"root\", [1], {k: 0.0 for k in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")}))\n    m.apply_boundary_conditions()\n    lc = LoadCase(\"tip\")\n    lc.add_nodal_load(n + 1, [0, 0, fz, 0, 0, 0])\n    m.add_load_case(lc)\n    return m, lc, n + 1\n\n\ndef run(builder, kin, steps=4):\n    m, lc, probe = builder()\n    try:\n        res = solve_static_nonlinear(m, lc, kinematics=kin, num_steps=steps, max_iterations=30)\n    except Exception as exc:  # noqa: BLE001\n        return f\"ERROR {type(exc).__name__}: {str(exc)[:90]}\"\n    d = m.mesh.dof_manager.get_node_dofs(probe)\n    amax = max((float(np.max(np.abs(s.get(\"alpha\", 0.0)))) for s in res.element_states.values()\n                if isinstance(s, dict)), default=0.0)\n    return f\"conv={res.converged} uz={res.displacements[d[2]]:+.5f} alpha_max={amax:.2e}\"\n\n\nif __name__ == \"__main__\":\n    which = sys.argv[1] if len(sys.argv) > 1 else \"all\"\n    cases = []\n    if which in (\"all\", \"beam\"):\n        for kin in (\"von_karman\", \"corotational\"):\n            for lab, s in ((\"elastic\", 1e4), (\"plastic\", 1.0)):\n                cases.append((f\"beam-only  {kin:12s} {lab}\", lambda s=s: beam_model(s, -2500.0), kin))\n    if which in (\"all\", \"shell\"):\n        for kin in (\"von_karman\", \"corotational\"):\n            for lab, s in ((\"elastic\", 1e4), (\"plastic\", 1.0)):\n                cases.append((f\"shell-only {kin:12s} {lab}\", lambda s=s: shell_model(s, False, -6000.0), kin))\n    if which in (\"all\", \"coupled\"):\n        for kin in (\"von_karman\", \"corotational\"):\n            for lab, s in ((\"elastic\", 1e4), (\"plastic\", 1.0)):\n                cases.append((f\"coupled    {kin:12s} {lab}\", lambda s=s: shell_model(s, True, -35000.0), kin))\n    for label, b, kin in cases:\n        print(label, \"->\", run(b, kin), flush=True)\n", "numLines": 113, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "113 lines from C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_isolation.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "effect-31c8bcbb-20ec-5597-8f66-10875839fd72", "sessionId": "b9a80757-48a2-a90d-2f72-692761706b93", "turnId": "turn-8c7e0354138e253f073f636b837c66de", "createdAt": 1792345665135, "updatedAt": 1792345665192, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "settledVerb": "Read", "settledMessage": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "content": "\"\"\"Coupled EP load sweep below collapse.\n\nChecks:\n  A. pre-yield: EP == elastic (alpha == 0, uz identical)\n  B. small rotation: corotational ~= von_karman (same material)\n  C. post-yield: EP deflection >= elastic deflection (softer)\n\"\"\"\nimport os\nimport sys\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nfrom ep_isolation import shell_model, run  # noqa: E402\n\nfor fz in (-2000.0, -6000.0, -10000.0, -14000.0):\n    for kin in (\"von_karman\", \"corotational\"):\n        el = run(lambda: shell_model(1e4, True, fz), kin, steps=6)\n        ep = run(lambda: shell_model(1.0, True, fz), kin, steps=6)\n        print(f\"Fz/node={fz:+8.0f} {kin:12s} EL: {el} | EP: {ep}\", flush=True)\n", "numLines": 17, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "17 lines from C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\ep_sweep.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "effect-9a5ae381-ef72-5117-b9e3-ae3d609884d5", "sessionId": "b9a80757-48a2-a90d-2f72-692761706b93", "turnId": "turn-8c7e0354138e253f073f636b837c66de", "createdAt": 1792345665145, "updatedAt": 1792345665207, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "settledVerb": "Read", "settledMessage": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "offset": null, "limit": 2000}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "content": "\"\"\"Slice 3 convergence study (reproduces the numbers in HANDOVER.md section 4).\n\nCantilever Q4 shell strip L=1.0, W=0.24, t=0.012, root clamped, centre-line\nbeam stiffener (10 x 40 mm rectangle) at eccentricity +0.04 z, coupled by\nCoupledBeamShellElement (beam node on a shell node) or\nInterpolatedBeamShellMPCElement (bilinear weights) otherwise.\n\nUsage (from C:/Github/ANYsolver):\n  python <this file> linear       # linear static: R1..R5, M1..M5, P1..P3\n  python <this file> nl_small     # corotational 12 kN (~2.5 deg): R1..R3\n  python <this file> nl_finite    # corotational 140 kN (~28 deg): M1..M3, P1..P3\n\"\"\"\nimport sys\nimport time\n\nimport numpy as np\nfrom scipy.sparse.linalg import spsolve\n\nfrom anysolver import BoundaryCondition, FEModel, LoadCase, create_shell_element, solve_static_nonlinear\nfrom anysolver.assembly import build_constraint_transformation\nfrom anysolver.elements import BeamElement, CoupledBeamShellElement\nfrom anysolver.matrix_assembly import assemble_load_vector, assemble_stiffness_matrix\nfrom anysolver.mesh_gen import InterpolatedBeamShellMPCElement\n\nCS = {\"area\": 0.01 * 0.04, \"Iy\": 0.01 * 0.04**3 / 12.0, \"Iz\": 0.04 * 0.01**3 / 12.0, \"J\": 1.0e-8}\n\nMESHES = {\n    # half-density beam (n_beam = nx/2): beam nodes coincide with every 2nd shell row\n    \"R1\": (4, 1, 2), \"R2\": (8, 2, 4), \"R3\": (16, 4, 8), \"R4\": (32, 8, 16), \"R5\": (64, 16, 32),\n    # equal density (n_beam = nx)\n    \"M1\": (4, 1, 4), \"M2\": (8, 2, 8), \"M3\": (16, 4, 16), \"M4\": (32, 8, 32), \"M5\": (64, 16, 64),\n    # non-matching (n_beam = 1.5 nx): genuinely interpolated couplings\n    \"P1\": (6, 2, 9), \"P2\": (10, 3, 15), \"P3\": (16, 4, 24),\n}\n\n\ndef build(nx, ny, n_beam, total_fz):\n    L, W, t = 1.0, 0.24, 0.012\n    r = np.array([0.0, 0.0, 0.04])\n    m = FEModel(f\"stiffened_{nx}x{ny}_b{n_beam}\")\n    m.add_material(\"steel\", 2.1e11, 0.3, density=7850.0)\n    grid, nid = {}, 1\n    for ix, x in enumerate(np.linspace(0.0, L, nx + 1)):\n        for iy, y in enumerate(np.linspace(-W / 2, W / 2, ny + 1)):\n            m.add_node(nid, float(x), float(y), 0.0)\n            grid[(ix, iy)] = nid\n            nid += 1\n    eid = 1\n    for ix in range(nx):\n        for iy in range(ny):\n            m.add_element(eid, create_shell_element(\n                eid, [grid[(ix, iy)], grid[(ix + 1, iy)], grid[(ix + 1, iy + 1)], grid[(ix, iy + 1)]],\n                \"steel\", thickness=t))\n            eid += 1\n    beam_nodes = []\n    for ib, xb in enumerate(np.linspace(0.0, L, n_beam + 1)):\n        b = 10000 + ib\n        m.add_node(b, float(xb), 0.0, float(r[2]))\n        beam_nodes.append(b)\n        sx = xb / (L / nx)\n        ix = min(int(np.floor(sx)), nx - 1)\n        xix = sx - ix\n        sy = 0.5 * ny\n        iy = min(int(np.floor(sy)), ny - 1)\n        xiy = sy - iy\n        cand = [(grid[(ix, iy)], (1 - xix) * (1 - xiy)), (grid[(ix + 1, iy)], xix * (1 - xiy)),\n                (grid[(ix + 1, iy + 1)], xix * xiy), (grid[(ix, iy + 1)], (1 - xix) * xiy)]\n        masters = [n for n, w in cand if w > 1e-12]\n        weights = np.array([w for n, w in cand if w > 1e-12])\n        mid = 20000 + ib\n        if len(masters) == 1:\n            m.add_element(mid, CoupledBeamShellElement(mid, b, masters[0], \"steel\", eccentricity=r))\n        else:\n            m.add_element(mid, InterpolatedBeamShellMPCElement(mid, b, masters, weights, eccentricity=r))\n    for ib in range(n_beam):\n        m.add_element(30000 + ib, BeamElement(30000 + ib, [beam_nodes[ib], beam_nodes[ib + 1]], \"steel\", dict(CS)))\n    m.add_boundary_condition(BoundaryCondition(\n        \"root\", [grid[(0, iy)] for iy in range(ny + 1)], {k: 0.0 for k in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")}))\n    m.apply_boundary_conditions()\n    lc = LoadCase(\"tip\")\n    for iy in range(ny + 1):\n        w = 0.5 if iy in (0, ny) else 1.0\n        lc.add_nodal_load(grid[(nx, iy)], [0.0, 0.0, total_fz * w / ny, 0.0, 0.0, 0.0])\n    m.add_load_case(lc)\n    return m, lc, beam_nodes[-1]\n\n\ndef tip(m, u, node):\n    d = m.mesh.dof_manager.get_node_dofs(node)\n    return float(u[d[0]]), float(u[d[2]]), float(np.rad2deg(abs(u[d[4]])))\n\n\ndef linear(names):\n    for name in names:\n        m, lc, node = build(*MESHES[name], total_fz=-12000.0)\n        K, _ = assemble_stiffness_matrix(m)\n        F, _ = assemble_load_vector(m, lc)\n        Kr, Fr, T, u0, _, _ = build_constraint_transformation(K, F, m)\n        u = np.asarray(T @ spsolve(Kr.tocsc(), Fr) + u0).reshape(-1)\n        ux, uz, ry = tip(m, u, node)\n        print(f\"{name}: uz={uz:.6f} ry_deg={ry:.6f}\", flush=True)\n\n\ndef nonlinear(names, total_fz):\n    for name in names:\n        t0 = time.perf_counter()\n        m, lc, node = build(*MESHES[name], total_fz=total_fz)\n        res = solve_static_nonlinear(m, lc, kinematics=\"corotational\", num_steps=4, max_iterations=25)\n        ux, uz, ry = tip(m, res.displacements, node)\n        print(f\"{name}: conv={res.converged} uz={uz:.6f} ux={ux:.6f} ry_deg={ry:.4f} \"\n              f\"dt={time.perf_counter() - t0:.2f}s\", flush=True)\n\n\nif __name__ == \"__main__\":\n    mode = sys.argv[1] if len(sys.argv) > 1 else \"linear\"\n    if mode == \"linear\":\n        linear([\"R1\", \"R2\", \"R3\", \"R4\", \"R5\", \"M1\", \"M2\", \"M3\", \"M4\", \"M5\", \"P1\", \"P2\", \"P3\"])\n    elif mode == \"nl_small\":\n        nonlinear([\"R1\", \"R2\", \"R3\"], -12000.0)\n    elif mode == \"nl_finite\":\n        nonlinear([\"M1\", \"M2\", \"M3\", \"P1\", \"P2\", \"P3\"], -140000.0)\n    else:\n        raise SystemExit(f\"unknown mode {mode!r}\")\n", "numLines": 123, "startLine": 1, "requestedOffset": null, "requestedLimit": 2000, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "123 lines from C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\convergence_study.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
