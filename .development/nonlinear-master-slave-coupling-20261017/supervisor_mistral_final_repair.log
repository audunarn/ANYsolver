\"tip\")\n    load.add_nodal_load(tip, forces=(0.0, 0.0, -100.0))\n    model.add_load_case(load)\n\n    real_assemble = nonlinear_static._assemble_nonlinear_system\n    assemble_calls = []\n\n    def never_improving_force(*args, **kwargs):\n        force, tangent, state = real_assemble(*args, **kwargs)\n        force = force.copy()\n        # Strictly growing unreconciled force: once the control row is\n        # satisfied, no line-search trial can decrease the augmented merit,\n        # which previously sustained the committed-full-step limit cycle.\n        assemble_calls.append(1)\n        assert len(assemble_calls) <= 60, \"no-improvement attempt retried without bound\"\n        force[model.mesh.dof_manager.get_node_dofs(tip)[2]] += 1.0e6 * len(assemble_calls)\n        return force, tangent, state\n\n    monkeypatch.setattr(nonlinear_static, \"_assemble_nonlinear_system\", never_improving_force)\n    result = solve_static_nonlinear(\n        model, load, control=\"displacement\",\n        displacement_control=DisplacementControl(node_id=tip, dof=\"uz\", target_displacement=-0.01),\n        kinematics=\"corotational\", num_steps=1, max_iterations=5,\n        tolerance=1.0e-8,\n    )\n    assert result.info[\"failure_reason\"] == \"line_search_no_improvement\"\n    assert result.status != \"completed\"\n    assert not result.steps and result.snapshots == ()\n    np.testing.assert_array_equal(result.displacements, np.zeros_like(result.displacements))\n```\n\nWait — trace attempt 1: iteration 1: assemble (call 1, perturbation 1e6). residual at zero state: F_int=0; F_external = lam*F_prop = 0... but the perturbation adds 1e6 to F_int? The wrapper adds to the assembled FORCE — which is F_int (internal force). residual = F_ext - F_int = -(1e6) at that dof reduced... residual_norm ~ 1e6-ish. Hmm — that changes iteration 1: residual nonzero. constraint = -0.01. Not converged. Solve → delta. Line search: merit_current = 1e6/(1e-8*ref) + 0.01/(1e-8*scale) — both terms; tr