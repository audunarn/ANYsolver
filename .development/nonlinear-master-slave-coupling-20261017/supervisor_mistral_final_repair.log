ing = sys.argv[1] if len(sys.argv) > 1 else \"direct\"\n    real_factorize = nonlinear_static.factorize\n    real_assemble = nonlinear_static._assemble_nonlinear_system\n    calls_since_iter = {\"tangent\": 0, \"residual\": 0}\n    iter_count = {\"n\": 0}\n\n    def counting_assemble(*args, **kwargs):\n        tangent = bool(kwargs.get(\"tangent\", True))\n        calls_since_iter[\"tangent\" if tangent else \"residual\"] += 1\n        return real_assemble(*args, **kwargs)\n\n    def probing_factorize(matrix, matrix_class, signature=None, **kwargs):\n        handle = real_factorize(matrix, matrix_class, signature=signature, **kwargs)\n        iter_count[\"n\"] += 1\n        print(\n            json.dumps(\n                {\n                    \"stage\": \"iter\",\n                    \"n\": iter_count[\"n\"],\n                    \"signature\": signature,\n                    \"residual_rhs\": None,\n                    \"constraint_rhs\": None,\n                    \"dq_norm\": None,\n                    \"dlam\": None,\n                    \"line_search_trials\": calls_since_iter[\"residual\"],\n                }\n            ),\n            flush=True,\n        )\n        calls_since_iter[\"tangent\"] = 0\n        calls_since_iter[\"residual\"] = 0\n        return _ProbingHandle(handle)\n\n    class _ProbingHandle:\n        def __init__(self, handle):\n            self._handle = handle\n\n        def solve(self, rhs):\n            delta = np.asarray(self._handle.solve(rhs), dtype=float).reshape(-1)\n            record = {\n                \"stage\": \"solve\",\n                \"n\": iter_count[\"n\"],\n                \"residual_rhs\": float(np.linalg.norm(np.asarray(rhs)[:-1])),\n                \"constraint_rhs\": float(np.asarray(rhs)[-1]),\n                \"dq_norm\": float(np.linalg.norm(delta[:-1])),\n                \"dlam\": float(delta[-1]),\n            }\n            print(json.dumps(record), flush=True)\n            return delta\n\n    nonlinear_static.factorize = probing_factorize\n    nonlinear_static._assemble_nonlinear_system = counting_assemble\n    try:\n        model, load, probe, grid = _build_ep_model(coupling)\n        _add_tip_load(model, load, grid)\n        result = solve_static_nonlinear(\n            model,\n            load,\n            control=\"displacement\",\n            displacement_control=DisplacementControl(\n                node_id=probe, dof=\"uz\", target_displacement=-0.20\n            ),\n            kinematics=\"corotational\",\n            num_steps=12,\n            max_iterations=40,\n            tolerance=1.0e-8,\n        )\n        dofs = model.mesh.dof_manager.get_node_dofs(probe)\n        uz = float(np.asarray(result.displacements)[dofs[2]])\n        summary = {\n            \"stage\": \"terminal\",\n            \"coupling\": coupling,\n            \"status\": result.status,\n            \"stop_reason\": result.info.get(\"stop_reason\"),\n            \"failure_reason\": result.info.get(\"failure_reason\"),\n            \"converged\": result.converged,\n            \"load_factor\": result.load_factor,\n            \"uz_probe\": uz,\n            \"total_newton_iterations\": result.info.get(\"total_newton_iterations\"),\n            \"control_attempts\": result.info.get(\"control_attempts\"),\n            \"control_cutbacks\": result.info.get(\"control_cutbacks\"),\n            \"control_line_search_reductions\": result.info.get(\n                \"control_line_search_reductions\"\n            ),\n            \"steps\": [\n                {\n                    \"step\": s.step_index,\n                    \"lam\": s.load_factor,\n                    \"iters\": s.iterations,\n                    \"res\": s.residual_norm,\n                    \"ctrl\": s.control_value,\n                    \"eps_p\": s.max_equivalent_plastic_strain,\n                }\n                for s in result.steps\n            ],\n        }\n        print(json.dumps(summary), flush=True)\n    finally:\n        nonlinear_static.factorize = real_factorize\n        nonlinear_static._assemble_nonlinear_system = real_assemble\n\n\nif __name__ == \"__main__\":\n    main()\n", "suffix": "", "verb": "Creating", "message": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/diagnostics/dc_final_repair_probe.py", "settledVerb": "Created", "settledMessage": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/diagnostics/dc_final_repair_probe.py", "statusText": "Writing file"}, "kind": "file_write", "input": {"filePath": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/diagnostics/dc_final_repair_probe.py", "content": "\"\"\"Probe: current-source direct full-target DC stop diagnosis (final repair).\n\nOne discriminating instrumented run, no sweeps. Runs the direct EP edge\ncoupling to uz=-0.20 (12 steps, 40 iterations, 1e-8) on the CURRENT source\nand records, per augmented factorization (one per Newton iteration):\n\n  - reduced residual norm ||rhs[:-1]|| and control constraint rhs[-1]\n  - step sizes ||delta[:-1]|| and load-factor increment delta[-1]\n  - number of _assemble_nonlinear_system calls since the previous\n    iteration, split by tangent flag (tangent=True is the main-loop\n    assembly; tangent=False calls are residual line-search trials)\n\nplus the per-accepted step records and final status/stop info. This is the\ncurrent per-accepted progress/iteration evidence required by\nSLICE3_FINAL_REPAIR.md; the earlier probes predate the residual line search.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport sys\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nsys.path.insert(\n    0,\n    os.path.join(\n        os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\", \"..\", \"tests\"\n    ),\n)\n\nimport numpy as np\n\nimport anysolver.nonlinear_static as nonlinear_static\nfrom test_nonlinear_beam_shell_slice3_continuation import (  # noqa: E402\