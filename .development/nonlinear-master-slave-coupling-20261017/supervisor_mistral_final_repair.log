nt(\n                elem_id,\n                create_shell_element(\n                    elem_id,\n                    [\n                        grid[(ix, iy)],\n                        grid[(ix + 1, iy)],\n                        grid[(ix + 1, iy + 1)],\n                        grid[(ix, iy + 1)],\n                    ],\n                    \"steel\",\n                    thickness=thickness,\n                ),\n            )\n            elem_id += 1\n\n    beam_nodes: list[int] = []\n    couplings: list[dict] = []\n    if route == \"eccentric\":\n        for ix, x in enumerate(xs):\n            master_id = grid[(ix, 0)]\n            b_id = 100 + ix\n            model.add_node(b_id, float(x), -0.5 * width, float(r_vec[2]))\n            beam_nodes.append(b_id)\n            mpc_id = 200 + ix\n            model.add_element(\n                mpc_id,\n                CoupledBeamShellElement(\n                    mpc_id, beam_node_id=b_id, shell_node_id=master_id,\n                    material_name=\"steel\", eccentricity=r_vec,\n                ),\n            )\n            couplings.append(\n                {\"slave\": b_id, \"masters\": [master_id],\n                 \"weights\": np.array([1.0]), \"r\": r_vec.copy()}\n            )\n    elif route == \"interpolated\":\n        weights = np.array([0.6, 0.4], dtype=float)\n        for ix, x in enumerate(xs):\n            m1 = grid[(ix, 0)]\n            m2 = grid[(ix, ny)]\n            b_id = 100 + ix\n            model.add_node(b_id, float(x), 0.0, float(r_vec[2]))\n            beam_nodes.append(b_id)\n            mpc_id = 200 + ix\n            model.add_element(\n                mpc_id,\n                InterpolatedBeamShellMPCElement(\n                    mpc_id, b_id, [m1, m2], weights, eccentricity=r_vec,\n                ),\n            )\n            couplings.append(\n                {\"slave\": b_id, \"masters\": [m1, m2],\n                 \"weights\": weights.copy(), \"r\": r_vec.copy()}\n            )\n    else:\n        raise ValueError(f\"Unknown route {route!r}\")\n\n    for ix in range(nx):\n        model.add_element(\n            300 + ix,\n            BeamElement(300 + ix, [beam_nodes[ix], beam_nodes[ix + 1]],\n                       \"steel\", cross_section=dict(CROSS_SECTION)),\n        )\n\n    root_nodes = [grid[(0, iy)] for iy in range(ny + 1)]\n    if root_supports:\n        model.add_boundary_condition(\n            BoundaryCondition(\n                \"root\", root_nodes,\n                {name: 0.0 for name in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")},\n            )\n        )\n    model.apply_boundary_conditions()\n    meta = {\n        \"route\": route,\n        \"grid\": grid,\n        \"beam_nodes\": beam_nodes,\n        \"root_nodes\": root_nodes,\n        \"couplings\": couplings,\n        \"eccentricity\": r_vec,\n        \"nx\": nx,\n        \"ny\": ny,\n    }\n    return model, meta\n\n\ndef _transformation(model: FEModel, load: LoadCase | None = None):\n", "stderr": "", "output": "", "truncated": false}, "outputText": "def _build_coupled_cantilever(\n    route: str,\n    *,\n    nx: int = 2,\n    ny: int = 1,\n    length: float = 1.0,\n    width: float = 0.2,\n    thickness: float = 0.02,\n    eccentricity: tuple[float, float, float] = (0.0, 0.0, 0.05),\n    root_supports: bool = True,\n) -> tuple[FEModel, dict]:\n    \"\"\"Cantilever Q4 shell strip with a coupled eccentric beam stiffener.\"\"\"\n    model = FEModel(f\"slice3_{route}_{nx}x{ny}\")\n    model.add_material(\"steel\", 2.1e11, 0.3, density=7850.0)\n    r_vec = np.asarray(eccentricity, dtype=float)\n\n    grid: dict[tuple[int, int], int] = {}\n    node_id = 1\n    xs = np.linspace(0.0, length, nx + 1)\n    ys = np.linspace(-0.5 * width, 0.5 * width, ny + 1)\n    for ix, x in enumerate(xs):\n        for iy, y in enumerate(ys):\n            model.add_node(node_id, float(x), float(y), 0.0)\n            grid[(ix, iy)] = node_id\n            node_id += 1\n\n    elem_id = 1\n    for ix in range(nx):\n        for iy in range(ny):\n            model.add_element(\n                elem_id,\n                create_shell_element(\n                    elem_id,\n                    [\n                        grid[(ix, iy)],\n                        grid[(ix + 1, iy)],\n                        grid[(ix + 1, iy + 1)],\n                        grid[(ix, iy + 1)],\n                    ],\n                    \"steel\",\n                    thickness=thickness,\n                ),\n            )\n            elem_id += 1\n\n    beam_nodes: list[int] = []\n    couplings: list[dict] = []\n    if route == \"eccentric\":\n        for ix, x in enumerate(xs):\n            master_id = grid[(ix, 0)]\n            b_id = 100 + ix\n            model.add_node(b_id, float(x), -0.5 * width, float(r_vec[2]))\n            beam_nodes.append(b_id)\n            mpc_id = 200 + ix\n            model.add_element(\n                mpc_id,\n                CoupledBeamShellElement(\n                    mpc_id, beam_node_id=b_id, shell_node_id=master_id,\n                    material_name=\"steel\", eccentricity=r_vec,\n                ),\n            )\n            couplings.append(\n                {\"slave\": b_id, \"masters\": [master_id],\n                 \"weights\": np.array([1.0]), \"r\": r_vec.copy()}\n            )\n    elif route == \"interpolated\":\n        weights = np.array([0.6, 0.4], dtype=float)\n        for ix, x in enumerate(xs):\n            m1 = grid[(ix, 0)]\n            m2 = grid[(ix, ny)]\n            b_id = 100 + ix\n            model.add_node(b_id, float(x), 0.0, float(r_vec[2]))\n            beam_nodes.append(b_id)\n            mpc_id = 200 + ix\n            model.add_element(\n                mpc_id,\n                InterpolatedBeamShellMPCElement(\n                    mpc_id, b_id, [m1, m2], weights, eccentricity=r_vec,\n                ),\n            )\n            couplings.append(\n                {\"slave\": b_id, \"masters\": [m1, m2],\n                 \"weights\": weights.copy(), \"r\": r_vec.copy()}\n            )\n    else:\n        raise ValueError(f\"Unknown route {route!r}\")\n\n    for ix in range(nx):\n        model.add_element(\n            300 + ix,\n            BeamElement(300 + ix, [beam_nodes[ix], beam_nodes[ix + 1]],\n                       \"steel\", cross_section=dict(CROSS_SECTION)),\n        )\n\n    root_nodes = [grid[(0, iy)] for iy in range(ny + 1)]\n    if root_supports:\n        model.add_boundary_condition(\n            BoundaryCondition(\n                \"root\", root_nodes,\n                {name: 0.0 for name in (\"ux\", \"uy\", \"uz\", \"rx\", \"ry\", \"rz\")},\n            )\n        )\n    model.apply_boundary_conditions()\n    meta = {\n        \"route\": route,\n        \"grid\": grid,\n        \"beam_nodes\": beam_nodes,\n        \"root_nodes\": root_nodes,\n        \"couplings\": couplings,\n        \"eccentricity\": r_vec,\n        \"nx\": nx,\n        \"ny\": ny,\n    }\n    return model, meta\n\n\ndef _transformation(model: FEModel, load: LoadCase | None = None):\n", "durationMs": 0.0, "display": {"success": true, "verb": "Ran", "message": "cd \"C:/Github/ANYsolver\" && sed -n '62,178p' tests/test_nonlinear_beam_shell_slice3.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
