or(t))\nprint(\"mean condition residual:\", np.linalg.norm(cond))\n\n# FD of apply_kinematics vs jacobian\nn_red = int(T.shape[1])\nJ = mpc_map.jacobian(u_nl).toarray()\neps = 1e-7\nmaxerr = 0.0\nfor j in range(n_red):\n    dq = np.zeros(n_red); dq[j] = eps\n    up = mpc_map.apply_kinematics(np.asarray(T @ (q + dq) + u0, dtype=float).reshape(-1))\n    um = mpc_map.apply_kinematics(np.asarray(T @ (q - dq) + u0, dtype=float).reshape(-1))\n    fd = (up - um) / (2 * eps)\n    maxerr = max(maxerr, float(np.linalg.norm(fd - J[:, j])))\nprint(\"J vs FD max col err:\", maxerr)\n\n# check slave rows explicitly: which rows mismatch\nfor j in (0, 1, 2, 3):\n    dq = np.zeros(n_red); dq[j] = eps\n    up = mpc_map.apply_kinematics(np.asarray(T @ (q + dq) + u0, dtype=float).reshape(-1))\n    um = mpc_map.apply_kinematics(np.asarray(T @ (q - dq) + u0, dtype=float).reshape(-1))\n    fd = (up - um) / (2 * eps)\n    diff = np.abs(fd - J[:, j])\n    bad = np.where(diff > 1e-6)[0]\n    print(\"col\", j, \"bad rows:\", bad[:10], \"max diff:\", diff.max() if len(diff) else 0)\n", "suffix": "", "verb": "Creating", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\debug_so3_map.py", "settledVerb": "Created", "settledMessage": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\debug_so3_map.py", "statusText": "Writing file"}, "kind": "file_write", "input": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\diagnostics\\debug_so3_map.py", "content": "import numpy as np\nfrom tests.test_nonlinear_beam_shell_coupling import (\n    _build_coupled_cantilever,\n    _interp_map_with_distinct_master_rotations,\n)\nfrom anysolver.assembly import build_constraint_transformation\nfrom anysolver.matrix_assembly import assemble_stiffness_matrix\nfrom anysolver.corotational import (\n    _so3_weighted_mean,\n    rotation_matrix_from_vector,\n    rotation_vector_from_ma