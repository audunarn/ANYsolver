{"id": "effect-bc325a2c-772d-5992-9b95-6c9cce6377d7", "sessionId": "341d9e81-6e08-2061-eb77-520faea41e81", "turnId": "turn-542b409187d41a418292618329863619", "createdAt": 1792350427236, "updatedAt": 1792350427435, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.bash", "detail": {"toolName": "file_system.bash", "display": {"summary": "bash: cd \"C:/Github/ANYsolver\" && python - <<'PYEOF'\nimport io\np = 'tests/test_nonlinear_beam_shell_coupling.py'\nwith io.open(p, 'r', newline='') as f:\n    s = f.read()\n\n# 1. module docstring\nold = '''\"\"\"Verification of Slice 2: Direct nonlinear master-slave beam-shell kinematic coupling.\n\nTests the exact finite-rotation master-slave kinematic elimination:\n    u_b = sum_i w_i u_{s,i} + (R(theta_bar_s) - I) r_0\n    theta_b = theta_bar_s = sum_i w_i theta_{s,i}\nwith state-dependent Jacobian J(q) = du/dq, reduced residual\nr_red(q) = J(q)^T (F_ext - F_int(u(q))), and symmetric geometric MPC tangent\nK_mpc,geom(q, F_int - F_ext), using zero Lagrange multipliers.\n\"\"\"'''\nnew = '''\"\"\"Verification of Slice 2: Direct nonlinear master-slave beam-shell kinematic coupling.\n\nTests the exact finite-rotation master-slave kinematic elimination.  On the\nactive rotating-offset route the slave orientation and offset frame are\ngoverned by the intrinsic weighted SO(3) mean R_m = mean(R_i, w_i):\n    u_b     = sum_i w_i u_{s,i} + (R_m - I) r_0\n    theta_b = theta_m = Log(R_m)\nwhich is rigid-spin equivariant for distinct master rotations (the direct\nsingle-master route and identical-rotation limit reproduce the legacy\naveraged map exactly), with state-dependent Jacobian J(q) = du/dq, reduced\nresidual r_red(q) = J(q)^T (F_ext - F_int(u(q))), and symmetric geometric\nMPC tangent K_mpc,geom(q, F_int - F_ext), using zero Lagrange multipliers.\n\"\"\"'''\nassert old in s\ns = s.replace(old, new, 1)\n\n# 2. imports\nold = \"\"\"from anysolver.corotational import (\n    build_nonlinear_rotating_mpc_map,\n    has_nonlinear_rotating_mpc,\n    rotating_mpc_geometric_hessian,\n    rotating_mpc_lever_arm_jacobian,\n    rotation_matrix_from_vector,\n    spatial_moment_from_rotation_covector,\n)\"\"\"\nnew = \"\"\"from anysolver.corotational import (\n    _rotation_left_jacobian_inverse,\n    _so3_weighted_mean,\n    build_nonlinear_rotating_mpc_map,\n    has_nonlinear_rotating_mpc,\n    rotating_mpc_geometric_hessian,\n    rotating_mpc_lever_arm_jacobian,\n    rotation_matrix_from_vector,\n    rotation_vector_from_matrix,\n    spatial_moment_from_rotation_covector,\n)\"\"\"\nassert old in s\ns = s.replace(old, new, 1)\n\n# 3. kinematic relation block\nold = \"\"\"    # Verify exact nonlinear rotating-arm kinematic relation at all coupled nodes\n    for coupling in meta[\"couplings\"]:\n        slave_dofs = model.mesh.dof_manager.get_node_dofs(coupling[\"slave\"])\n        u_s_bar = np.zeros(3, dtype=float)\n        theta_s_bar = np.zeros(3, dtype=float)\n        for m_id, w in zip(coupling[\"masters\"], coupling[\"weights\"]):\n            m_dofs = model.mesh.dof_manager.get_node_dofs(m_id)\n            u_s_bar += float(w) * u[m_dofs[:3]]\n            theta_s_bar += float(w) * u[m_dofs[3:6]]\n        expected_u_b = u_s_bar + (rotation_matrix_from_vector(theta_s_bar) - np.eye(3)) @ coupling[\"r\"]\n        np.testing.assert_allclose(u[slave_dofs[:3]], expected_u_b, rtol=1.0e-12, atol=1.0e-14)\n        np.testing.assert_allclose(u[slave_dofs[3:6]], theta_s_bar, rtol=1.0e-12, atol=1.0e-14)\"\"\"\nnew = \"\"\"    # Verify exact nonlinear rotating-arm kinematic relation at all coupled nodes\n    K0_kin, _ = assemble_stiffness_matrix(model)\n    _zero = np.zeros(K0_kin.shape[0], dtype=float)\n    _, _, T_kin, _, _, _ = build_constraint_transformation(K0_kin, _zero, model)\n    kin_map = build_nonlinear_rotating_mpc_map(model, T_kin)\n    assert kin_map is not None\n    for entry in kin_map.entries:\n        slave_u_dofs = list(entry.slave_u_dofs)\n        slave_theta_dofs = list(entry.slave_theta_dofs)\n        theta_m, _G = entry.mean_state(u)\n        u_s_bar = entry.master_translation(u)\n        expected_u_b = u_s_bar + (rotation_matrix_from_vector(theta_m) - np.eye(3)) @ entry.eccentricity\n        np.testing.assert_allclose(u[slave_u_dofs], expected_u_b, rtol=1.0e-12, atol=1.0e-14)\n        np.testing.assert_allclose(u[slave_theta_dofs], theta_m, rtol=1.0e-12, atol=1.0e-14)\"\"\"\nassert old in s\ns = s.replace(old, new, 1)\n\n# 4. wrench identity block\nold = \"\"\"    for entry in mpc_map.entries:\n        f_b = out_of_balance[list(entry.slave_u_dofs)]\n        m_b = out_of_balance[list(entry.slave_theta_dofs)]\n        theta_bar = entry.master_rotation(u)\n        A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\n        spatial_torque_from_pullback = spatial_moment_from_rotation_covector(\n            theta_bar, m_b + A.T @ f_b\n        )\n        t_b = spatial_moment_from_rotation_covector(theta_bar, m_b)\n        r_spatial = rotation_matrix_from_vector(theta_bar) @ entry.eccentricity\n        spatial_torque_expected = t_b + np.cross(r_spatial, f_b)\"\"\"\nnew = \"\"\"    for entry in mpc_map.entries:\n        f_b = out_of_balance[list(entry.slave_u_dofs)]\n        m_b = out_of_balance[list(entry.slave_theta_dofs)]\n        theta_m, _G = entry.mean_state(u)\n        A = rotating_mpc_lever_arm_jacobian(theta_m, entry.eccentricity)\n        spatial_torque_from_pullback = spatial_moment_from_rotation_covector(\n            theta_m, m_b + A.T @ f_b\n        )\n        t_b = spatial_moment_from_rotation_covector(theta_m, m_b)\n        r_spatial = rotation_matrix_from_vector(theta_m) @ entry.eccentricity\n        spatial_torque_expected = t_b + np.cross(r_spatial, f_b)\"\"\"\nassert old in s\ns = s.replace(old, new, 1)\n\nwith io.open(p, 'w', newline='') as f:\n    f.write(s)\nprint('edits ok')\nPYEOF\npython -c \"import ast; ast.parse(open('tests/test_nonlinear_beam_shell_coupling.py',encoding=