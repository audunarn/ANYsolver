--- a/tests/test_nonlinear_beam_shell_slice3.py
+++ b/tests/test_nonlinear_beam_shell_slice3.py
@@ -1028,6 +1028,51 @@
 # ---------------------------------------------------------------------------
 # Final repair: typed domain refusal, trial backtracking, classified failure
 # ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("plastic", (False, True))
+@pytest.mark.parametrize("domain", (False, True))
+def test_dc_postyield_resolution_has_failure_specific_finite_rollback_bounds(monkeypatch, plastic, domain):
+    import anysolver.nonlinear_static as ns
+    from anysolver.corotational import NonlinearRotatingMPCMap
+    model, meta = _build_coupled_cantilever("eccentric", nx=2, ny=1)
+    tip = meta["grid"][(meta["nx"], 0)]
+    load = LoadCase("tip"); load.add_nodal_load(tip, forces=(0., 0., -100.))
+    model.add_load_case(load)
+    state = model.mesh.elements[1].init_nonlinear_state(5)
+    if plastic:
+        state["alpha"][:] = 1e-5
+    initial = {1: state}; before = copy.deepcopy(initial)
+    if domain:
+        real_apply = NonlinearRotatingMPCMap.apply_kinematics
+        def refuse_nonzero(self, value):
+            if np.any(value):
+                raise SO3MeanDomainError("synthetic bounded chart refusal")
+            return real_apply(self, value)
+        monkeypatch.setattr(NonlinearRotatingMPCMap, "apply_kinematics", refuse_nonzero)
+    else:
+        class NoCorrection:
+            def solve(self, rhs): return np.zeros_like(rhs)
+        monkeypatch.setattr(ns, "factorize", lambda *a, **kw: NoCorrection())
+    result = solve_static_nonlinear(
+        model, load, control="displacement",
+        displacement_control=DisplacementControl(node_id=tip, dof="uz", target_displacement=-.001),
+        kinematics="corotational", num_steps=1, max_iterations=1, tolerance=1e-8,
+        initial_element_states=initial, equilibrate_initial_state=False,
+        emit_restart_checkpoint=False, record_increment_snapshots=True)
+    expected_limit = 16 if plastic and not domain else 8
+    evidence = result.info["displacement_control_adaptation"]
+    assert evidence["cutbacks"] == expected_limit
+    assert evidence["attempts"] == expected_limit+1
+    assert evidence["terminal_failure"]["cutback_limit"] == expected_limit
+    assert evidence["terminal_failure"]["min_subincrement"] == .001/2**expected_limit
+    assert evidence["domain_refusal_max_cutbacks_per_interval"] == 8
+    assert evidence["max_accepted_subincrements_per_milestone"] == 257
+    assert result.status != "completed" and not result.steps and not result.snapshots
+    np.testing.assert_array_equal(result.displacements, np.zeros_like(result.displacements))
+    for field in state:
+        if isinstance(state[field], np.ndarray):
+            np.testing.assert_array_equal(initial[1][field], before[1][field])
 
 
