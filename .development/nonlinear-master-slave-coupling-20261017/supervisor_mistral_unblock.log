   assert item_a.shape == item_b.shape\n                    np.testing.assert_allclose(\n                        item_a, item_b, rtol=1.0e-6, atol=1.0e-9\n                    )\n                elif isinstance(item_a, (dict, list, tuple)):\n                    _assert_states_allclose(item_a, item_b)\n                else:\n                    assert item_a == item_b\n        elif isinstance(a, float):\n            np.testing.assert_allclose(a, b, rtol=1.0e-6, atol=1.0e-9)\n        else:\n            assert a == b\n\n\ndef _snapshot_at_control(snapshots, control_value: float):\n    matches = [\n        s for s in snapshots if abs(s.control_value - control_value) <= 1.0e-6\n    ]\n    assert len(matches) == 1, (\n        control_value,\n        [round(s.control_value, 9) for s in snapshots],\n    )\n    return matches[0]\n\n\ndef _equilibrium_oracle(case: dict) -> dict:", "replaceAll": false}]}}, "state": {"status": "completed", "output": {"file": "C:\\Github\\ANYsolver\\tests\\test_nonlinear_beam_shell_slice3_continuation.py", "oldString": null, "newString": null, "occurrences": [{"startLine": 308, "oldText": "def _equilibrium_oracle(case: dict) -> dict:", "newText": "def _assert_states_allclose(left, right) -> None:\n    \"\"\"Compare complete physical material histories at restart tolerances.\n\n    T3: scalar alpha maxima alone can conceal changed distributions or a\n    partially reset state, so every integration-point/fiber entry of the\n    plastic-strain tensors, alpha arrays and fiber histories is compared\n    with the existing strict restart tolerances (rtol 1e-6, atol 1e-9).\n    \"\"\"\n    assert set(left) == set(right)\n    for key in left:\n        a, b = left[key], right[key]\n        assert type(a) is type(b)\n        if isinstance(a, np.ndarray):\n            assert a.shape == b.shape\n            np.testing.assert_allclose(a, b, rtol=1.0e-6, atol=1.0e-9)\n        elif isinstance(a, dict):\n            _assert_states_allclose(a, b)\n        elif isi