nactual anysolver import origin against the selected root.\r\n\"\"\"\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport hashlib\r\nimport json\r\nimport os\r\nimport re\r\nimport subprocess\r\nimport sys\r\nimport time\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\n\r\nTASK_DIR = Path(__file__).resolve().parent\r\nREPO = TASK_DIR.parents[1]\r\nEVIDENCE = TASK_DIR / \"evidence\"\r\nBUDGET_FILE = TASK_DIR / \"budget.json\"\r\nLOCK_FILE = TASK_DIR / \"running.lock\"\r\nALLOWANCE = 3600.0\r\nRESERVE = 900.0\r\n\r\nIDENTITY_FILES = [\r\n    \"src/anysolver/corotational.py\",\r\n    \"src/anysolver/elements.py\",\r\n    \"src/anysolver/mesh_gen.py\",\r\n    \"src/anysolver/nonlinear_static.py\",\r\n    \"src/anysolver/nonlinear_performance.py\",\r\n    \"tests/test_corotational_work_conjugate.py\",\r\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\r\n]\r\n\r\nCHILD_ENV = {\r\n    \"OMP_NUM_THREADS\": \"1\",\r\n    \"OPENBLAS_NUM_THREADS\": \"1\",\r\n    \"MKL_NUM_THREADS\": \"1\",\r\n    \"NUMEXPR_NUM_THREADS\": \"1\",\r\n    \"NUMBA_NUM_THREADS\": \"1\",\r\n    \"NUMBA_DISABLE_JIT\": \"1\",\r\n    \"PYTHONDONTWRITEBYTECODE\": \"1\",\r\n    \"PYTHONHASHSEED\": \"0\",\r\n    \"PYTHONNOUSERSITE\": \"1\",\r\n    \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\": \"1\",\r\n    \"ANYSOLVER_RUN_RETIRED_PROGRAMME_TESTS\": \"0\",\r\n}\r\n\r\nPREFLIGHT_CODE = r\"\"\"\r\nimport json, sys\r\ninfo = {\"python\": sys.version}\r\ntry:\r\n    import numpy, scipy\r\n    info[\"numpy\"] = numpy.__version__\r\n    info[\"scipy\"] = scipy.__version__\r\nexcept Exception as exc:\r\n    info[\"numpy_error\"] = repr(exc)\r\nfor name in (\"anysolver\", \"anymaterial\", \"anygeometry\", \"anymesher\", \"anyfileio\"):\r\n    try:\r\n        mod = __import__(name)\r\n        info[name] = {\r\n            \"version\": getattr(mod, \"__version__\", None),\r\n            \"origin\": getattr(mod, \"__file__\", None),\r\n        }\r\n    except Exception as exc:\r\n        info[name] = {\"error\": repr(exc)}\r\ntry:\r\n    import numba\r\n    info[\"nu\r\n", "durationMs": 0.0, "display": {"success": true, "verb": "Ran", "message": "cd \"C:/Github/ANYsolver\" && python -c \"import re,sys; src=open('.development/nonlinear-master-slave-coupling-20261017/harness.py').read(); print(src[:3000])\"", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
