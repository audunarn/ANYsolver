alent_plastic_strain=float(_max_plastic_strain(committed_states)),\r\n                        support_reactions={\r\n                            name: list(values)\r\n                            for name, values in support_reactions.items()\r\n                        },\r\n                    )\r\n                    exact_guard(\r\n                        model,\r\n                        context=\"nonlinear static displacement-control progress callback\",\r\n                    )\r\n                if attempt_fraction >= 1.0:\r\n                    break\r\n                # The accepted increment was a subdivision of the current\r\n                # control interval; continue with the remaining interval.\r\n                attempt_fraction = 1.0\r\n            if failure_reason is not None:\r\n                break\r\n\r\n    u_final = full_u(q)\r\n    if (not steps and not committed_states and (\r\n            augmented_contact_manager is not None\r\n            or any(_qualified_s3_committed_state_validator(element) is not None\r\n                   for element in model.mesh.elements.values()))):\r\n        # A rejected first trial has no committed candidate. Recover the\r\n        # accepted origin through the normal structural owner before sealing;\r\n        # do not substitute the failed trial or mask its failure status.\r\n        _initial_force, _initial_tangent, reference_states = (\r\n            _assemble_nonlinear_system(\r\n                model, u_final, committed_states, num_layers,\r\n                tangent=False, kinematics=kinematics,\r\n                corotational_tangent=corotational_tangent,\r\n            )\r\n        )\r\n        committed_states = _commit_nonlinear_state_candidate(\r\n            committed_states, reference_states, model=model,\r\n            accepted_displacements=u_final,\r\n        )\r\n    committed_states = _materialize_final_nonlinear_states(committed_states, info)\r\n    committed_states = _finalize_nonlinear_element_states(\r\n        model,\r\n        u_final,\r\n        committed_states,\r\n        num_layers,\r\n        kinematics=kinematics,\r\n    )\r\n    committed_states = _seal_final_qualified_q4_states(\r\n        model,\r\n        u_final,\r\n        committed_states,\r\n        num_layers,\r\n        info,\r\n        kinematics=kinematics,\r\n    )\r\n    if adaptive_control_subdivision:\r\n        info[\"displacement_control_adaptation\"] = {\r\n            \"attempts\": int(control_attempts_total),\r\n            \"cutbacks\": int(control_cutbacks_total),\r\n            \"max_cutbacks_per_interval\": int(max_control_cutbacks),\r\n            \"min_subincrement\": float(min_control_subincrement),\r\n            \"applied\": control_cutbacks_total > 0,\r\n        }\r\n    info[\"failure_reason\"] = failure_reason\r\n    info[\"stop_reason\"] = \"target_displacement_reached\" if failure_reason is None else failure_reason\r\n    info[\"status_category\"] = _nonlinear_status_category(status, failure_reason)\r\n    info[\"last_converged_load_factor\"] = float(lam)\r\n", "numLines": 200, "startLine": 4241, "requestedOffset": 4241, "requestedLimit": 200, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "200 lines from C:\\Github\\ANYsolver\\src\\anysolver\\nonlinear_static.py", "warnings": [], "approvalNote": null, "suffix": "(truncated)"}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "reasoning-19a84072-d3b4-5b40-9b3c-9390b78b0c1c-0", "sessionId": "01f7c834-c499-fb2f-0e3f-33d4d208c428", "turnId": "turn-d4c99f7f7fae63d9ba666324f5523e64", "createdAt": 1792349504249, "updatedAt": 1792349504249, "generationStatus": "completed", "relatedEntryId": null, "type": "reasoning", "text": "Now I understand the DC loop fully. Let me plan the DC1/DC2 fixes:\n\n**DC1 (zero-span infinite retry):** The cutback condition at ~4204:\n```python\nif (\n    failure_reason == \"maximum_iterations_reached\"\n    and adaptive_control_subdivision\n    and abs(milestone - attempt_start_control)\n        * attempt_fraction * 0.5\n        >= min_control_subincrement\n):\n```\nWhen milestone == attempt_start_control (zero span), `abs(...)` is 0, and `min_control_subincrement` is `abs(target_increment)/num_steps/256`. If target_increment is 0 (zero-span request: requested target equals initial controlled displacement for the whole solve), then min_control_subincrement = 0, and `0 >= 0` is True forever. Also even if target_increment != 0 but milestone == attempt_start_control (e.g., restart at current target), span is 0 < min, so `0*0.5 >= min` is False → terminates. Wait: `abs(milestone - attempt_start_control) * attempt_fraction * 0.5 >= min_control_subincrement`. If span is zero and min > 0, then 0 >= min is False → no retry, terminates with minimum_control_step_reached. The infinite retry only happens when min_control_subincrement == 0, i.e., target_increment == 0. That's the \"zero-span\" case: requested target equals initial controlled displacement → target_increment = 0 → min = 0 → 0 >= 0 true forever.\n\nFix: require strictly positive finite attempted span AND representable target progress before subdivision, with explicit bounded minimum. Also bound the number of cutbacks per interval (currently max_control_cutbacks only scales min, no count check). Add a cutback count bound: cutbacks_this_step <= max_control_cutbacks.\n\nFix plan:\n- Compute `min_control_subincrement` guarded: if target_increment == 0 or not finite, set to something strictly positive? Actually with target_increment=0, milestone == initial_control for every step, span is always zero. The correct behavior: a zero-span request can run its bounded Newton attempt but must retain a finite failure exit. So the cutback condition must require `attempted_span = abs(milestone - attempt_start_control) * attempt_fraction` to be strictly positive and finite, and `attempted_span * 0.5 >= max(min_control_subincrement, tiny)`. Plus explicit cutback count bound `cutbacks_this_step < max_control_cutbacks`.\n\nLet me write:\n```python\nattempted_span = abs(milestone - attempt_start_control) * attempt_fraction\nif (\n    failure_reason == \"maximum_iterations_reached\"\n    and adaptive_control_subdivision\n    and np.isfinite(attempted_span)\n    and attempted_span > 0.0\n    and attempted_span * 0.5 >= min_control_subincrement\n    and cutbacks_this_step < max_control_cutbacks\n):\n```\nAnd min_control_subincrement: keep as is but guard division — `abs(target_increment)/max(num_steps,1)/(2**max_control_cutbacks)`; if target_increment==0 this is 0, but the attempted_span > 0 check now prevents infinite retry. Also add finite check. Also when cutbacks exhausted, failure_reason becomes \"minimum_control_step_reached\" (existing branch). Good.\n\n**DC2 (step_iterations accumulation):** `step_iterations` initialized once per milestone at 3981, incremented at 4172 (`step_iterations += iteration`) after each attempt. Every accepted subincrement publishes cumulative count. Fix: track per-published-increment accumulator. Reset after acceptance publication. Keep cumulative attempt accounting in separate fields (attempts_this_step, cutbacks_this_step already exist and are cumulative per milestone — the review says these should state their scope; they're already named control_attempts/control_cutbacks per milestone, fine).\n\nImplementation: add `published_iterations = 0` per attempt? Actually per accepted publication interval: reset `step_iterations = 0` right after publishing (after the history.append / progress emit), or track `interval_iterations` that resets at each acceptance. Simplest: after the acceptance publication block (after progress_callback), set `step_iterations = 0` before continuing the while loop for the remaining interval. But careful: `step_iterations` is also used in progress emit and NonlinearStaticStep — those use the value at publication time, which is the sum over attempts since last acceptance. Resetting after publication gives per-published-increment counts. But wait — the reset must happen only for the adaptive route? For legacy route (no subdivision), each milestone publishes once, and step_iterations is reset per milestone at 3981 anyway. Resetting after publication is harmless for legacy too (value already consumed). But careful: `step_iterations = 0` after publication — for the legacy path, the while loop breaks at `if attempt_fraction >= 1.0: break` before... actually the reset should be placed just before `if attempt_fraction >= 1.0: break` or after. Let me place it right after the progress emit, before the `attempt_fraction >= 1.0` check:\n\n```python\n# Per-published-increment iteration count: reset after each accepted\n# publication so subdivided increments do not double-count prior\n# accepted work (DC2).  Solve-wide totals remain in total_iterations.\nstep_iterations = 0\nif attempt_fraction >= 1.0:\n    break\n```\n\nHmm, but there's a subtlety: `step_iterations` is incremented at 4172 after each attempt (including failed attempts within the same publication interval). That's correct: the published record should include iterations of failed attempts within that interval? The review says \"Reset the per-published-increment iteration accumulator after acceptance (or at the start of the next publication interval). Keep failed-attempt counts and scheduled-milestone totals in explicitly cumulative fields if desired.\" So including failed-attempt iterations of the current interval in the published record is fine; the point is not to carry over previous accepted subincrements' counts. My reset-after-publication achieves that.\n\nAlso the review notes progress emits `completed=local_step_index` even for accepted subdivision before milestone reached — \"should be labelled milestone index or replaced by monotone fractional milestone progress\". That's a P2-ish note; the brief says fix DC1/DC2 and \"misleading per-record iteration accumulation\". The progress labeling is optional; I could add a `milestone_index` label. Minor: I'll leave progress as is to keep the diff minimal — actually the review says \"should be labelled milestone index or replaced by monotone fractional milestone progress\". The brief item 1 says \"Fix confirmed zero-span infinite adaptive retry and misleading per-record iteration accumulation\". So DC1+DC2 only. I'll keep progress unchanged.\n\n**D1 spy regression:** Add a focused test asserting the public DC assembled-augmented path passes MatrixClass.GENERAL to factorize, independent of PARDISO, using a fake/spy backend that records the declared class and delegates the solve unchanged. Need to see how `factorize` is exposed — it's presumably imported into nonlinear_static. Let me check imports and how tests can monkeypatch. The test should spy on the factorize used in nonlinear_static (e.g., monkeypatch `nonlinear_static.factorize` with a wrapper that records matrix_class and delegates to the real one). That's \"declared-matrix-class spy/fake-backend assertion on the public DC assembled-augmented path; it must see GENERAL independently of optional PARDISO availability, while delegating the actual solve unchanged.\"\n\nSo: monkeypatch `src.anysolver.nonlinear_static.factorize` with a spy that records MatrixClass and calls the original. Run a small rotating-MPC DC solve. Assert recorded classes include GENERAL (all of them GENERAL on the rotating route). This works regardless of PARDISO since we delegate to the real factorize which falls back to SciPy if PARDISO absent.\n\nNow the DC unblock (item 2). The evidence: direct DC stalls at uz=-0.1833 with max_iterations_reached at min-step. The brief says: first obtain single direct test's actual failure via -x rather than buffered two-route timeout. Then pick a compatible internal globalization or predictor (e.g., residual line search retaining committed histories) rather than further load sweeps. Also ordinary resume lambda recovery from copied equilibrium permitted as Newton guess.\n\nAnd item 3: interp wrench failure — derive discriminating global rigid-spin virtual-work/objectivity check before changing mechanics; propose objective SO(3) mean at early checkpoint.\n\nBudget: 450s additional numerical. That's tight. A single direct DC test with -x: the EP module tests take ~40s per run of the full module (slice3-continuation-achievable-1 was 39s for 11 tests). A single test with -x should be maybe 10-30s. Then implementing line search and rerunning.\n\nLet me now look at the test module to understand the EP continuation tests and find the direct test node ID. Also look at the harness to know how to run things.\n\nLet me read the test module.", "summary": []}
