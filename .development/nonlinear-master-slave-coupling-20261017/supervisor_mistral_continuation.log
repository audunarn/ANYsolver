{"id": "effect-6c643b9c-f74a-58cb-81a9-1da0f2637c91", "sessionId": "d77c8371-229c-7034-6088-eaefcc4b4445", "turnId": "turn-6f19a1036e2fefd5642f253cb635b74b", "createdAt": 1792347189815, "updatedAt": 1792347189999, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:/Github/ANYsolver/src/anysolver/corotational.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:/Github/ANYsolver/src/anysolver/corotational.py", "settledVerb": "Read", "settledMessage": "C:/Github/ANYsolver/src/anysolver/corotational.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:/Github/ANYsolver/src/anysolver/corotational.py", "offset": 1369, "limit": 75}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\src\\anysolver\\corotational.py", "content": "        \"\"\"Return ``J(u)^T full_force`` without materializing ``J(u)``.\"\"\"\r\n        f = np.asarray(full_force, dtype=float).reshape(-1)\r\n        if not self.entries:\r\n            return np.asarray(self.T_linear.T @ f, dtype=float).reshape(-1)\r\n        u = np.asarray(u_current, dtype=float).reshape(-1)\r\n        f_mod = f.copy()\r\n        for entry in self.entries:\r\n            f_b = f[entry.slave_u_dofs]\r\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\r\n                continue\r\n            theta_bar = entry.master_rotation(u)\r\n            A = rotating_mpc_lever_arm_jacobian(theta_bar, entry.eccentricity)\r\n            delta_A = A + entry.r_skew\r\n            f_mod[entry.slave_theta_dofs] += delta_A.T @ f_b\r\n        return np.asarray(self.T_linear.T @ f_mod, dtype=float).reshape(-1)\r\n\r\n    def geometric_tangent(\r\n        self,\r\n        u_current: np.ndarray,\r\n        full_imbalance: np.ndarray,\r\n    ) -> Any:\r\n        \"\"\"Return ``K_mpc,geom(u, F_int - F_ext) = sum_b Theta_b^T H_b Theta_b``.\"\"\"\r\n        from scipy import sparse\r\n\r\n        if not self.entries or self.n_red == 0:\r\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\r\n        u = np.asarray(u_current, dtype=float).reshape(-1)\r\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1)\r\n        terms = []\r\n        for entry in self.entries:\r\n            if entry.theta_proj.nnz == 0:\r\n                continue\r\n            f_b = imbalance[entry.slave_u_dofs]\r\n            if float(np.linalg.norm(f_b)) <= 1.0e-30:\r\n                continue\r\n            theta_bar = entry.master_rotation(u)\r\n            H_b = rotating_mpc_geometric_hessian(\r\n                theta_bar, entry.eccentricity, f_b\r\n            )\r\n            terms.append(entry.theta_proj.T @ sparse.csr_matrix(H_b) @ entry.theta_proj)\r\n        if not terms:\r\n            return sparse.csr_matrix((self.n_red, self.n_red), dtype=float)\r\n        total = terms[0]\r\n        for term in terms[1:]:\r\n            total = total + term\r\n        return total.tocsr()\r\n\r\n    def reduce_tangent(\r\n        self,\r\n        u_current: np.ndarray,\r\n        K_T: Any,\r\n        full_imbalance: Optional[np.ndarray] = None,\r\n        K_ext: Optional[Any] = None,\r\n    ) -> Any:\r\n        \"\"\"Return ``J(u)^T (K_T - K_ext) J(u) + K_mpc,geom(u, full_imbalance)``.\"\"\"\r\n        J = self.jacobian(u_current)\r\n        K_red = (J.T @ K_T @ J).tocsr()\r\n        if K_ext is not None and getattr(K_ext, \"nnz\", 0):\r\n            K_red = (K_red - (J.T @ K_ext @ J)).tocsr()\r\n        if full_imbalance is not None:\r\n            K_geom = self.geometric_tangent(u_current, full_imbalance)\r\n            if K_geom.nnz:\r\n                K_red = (K_red + K_geom).tocsr()\r\n        return K_red\r\n\r\n    def transfer_slave_imbalance_to_masters(\r\n        self,\r\n        u_current: np.ndarray,\r\n        full_imbalance: np.ndarray,\r\n    ) -> np.ndarray:\r\n        \"\"\"Transfer slave forces/moments to master shell DOFs for support reactions.\"\"\"\r\n        imbalance = np.asarray(full_imbalance, dtype=float).reshape(-1).copy()\r\n        if not self.entries:\r\n            return imbalance\r\n        u = np.asarray(u_current, dtype=float).reshape(-1)\r\n", "numLines": 75, "startLine": 1369, "requestedOffset": 1369, "requestedLimit": 75, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "75 lines from C:\\Github\\ANYsolver\\src\\anysolver\\corotational.py", "warnings": [], "approvalNote": null, "suffix": "(truncated)"}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
