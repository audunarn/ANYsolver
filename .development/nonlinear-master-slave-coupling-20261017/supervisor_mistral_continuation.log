librate_initial_state=False,\n        **common,\n    )\n    assert resumed.converged\n\n    fresh_model, fresh_meta = _build_coupled_cantilever(\n        route,\n        nx=2,\n        ny=1,\n        eccentricity=(0.0, 0.0, 0.05),\n    )\n    fresh_load = LoadCase(\"full_tip_load\")\n    fresh_load.add_nodal_load(\n        fresh_meta[\"beam_nodes\"][-1],\n        forces=(-2.0e4, 1.0e4, -2.5e5),\n    )\n    uninterrupted = solve_static_nonlinear(\n        fresh_model,\n        fresh_load,\n        max_load_factor=1.0,\n        num_steps=4,\n        max_iterations=25,\n        tolerance=1.0e-10,\n        kinematics=\"corotational\",\n        corotational_tangent=\"auto\",\n    )\n    assert uninterrupted.converged\n    np.testing.assert_allclose(\n        resumed.displacements,\n        uninterrupted.displacements,\n        rtol=1.0e-8,\n        atol=1.0e-10,\n    )\n\n", "numLines": 68, "startLine": 619, "requestedOffset": 619, "requestedLimit": 70, "totalLines": null, "wasTruncated": false}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "68 lines from C:\\Github\\ANYsolver\\tests\\test_nonlinear_beam_shell_coupling.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
