eros(n_red, dtype=float)\n        dq[j] = eps\n        K_ext_fd[:, j] = (\n            ext_reduced_force(q + dq) - ext_reduced_force(q - dq)\n        ) / (2.0 * eps)\n\n    ext_scale = np.linalg.norm(K_ext_fd, ord=\"fro\")\n    assert ext_scale > 0.0\n    rel_err_ext = np.linalg.norm(\n        K_ext_red - K_ext_fd, ord=\"fro\"\n    ) / ext_scale\n    assert rel_err_ext < 1.0e-6", "replaceAll": false}]}}, "state": {"status": "completed", "output": {"file": "C:\\Github\\ANYsolver\\tests\\test_nonlinear_beam_shell_slice3.py", "oldString": null, "newString": null, "occurrences": [{"startLine": 567, "oldText": "    rel_err = np.linalg.norm(K_red - K_fd, ord=\"fro\") / np.linalg.norm(\n        K_fd, ord=\"fro\"\n    )\n    assert rel_err < 1.0e-6", "newText": "    rel_err = np.linalg.norm(K_red - K_fd, ord=\"fro\") / np.linalg.norm(\n        K_fd, ord=\"fro\"\n    )\n    assert rel_err < 1.0e-6\n\n    # External reduced-force derivative on its own scale: with steel\n    # stiffness a relative full-system tolerance can hide an absent external\n    # load tangent.  Differentiate J(u)^T F_ext(u) and compare against\n    # J^T K_ext J + geometric_tangent(u, F_ext), normalized by that matrix.\n    def ext_reduced_force(q_vec: np.ndarray) -> np.ndarray:\n        u_q = full_u(q_vec)\n        f_ext_q, _ = _weighted_external_load_system(\n            model, [(load, 1.0)], u_q, tangent=False\n        )\n        return mpc_map.reduce_force(u_q, f_ext_q)\n\n    J = mpc_map.jacobian(u)\n    K_ext_red = (\n        (J.T @ K_ext @ J).toarray()\n        + np.asarray(\n            mpc_map.geometric_tangent(u, f_ext).todense()\n        )\n    )\n    K_ext_fd = np.zeros_like(K_ext_red)\n    for j in range(n_red):\n        dq = np.zeros(n_red, dtype=float)\n        dq[j] = eps\n        K_ext_fd[:, j] = (\n            ext_reduced_force(q + dq) - ext_reduced_force(q - dq)\n        ) / (2.0 * eps)\n\n    ext_scale = np.linalg.norm(K_ext_fd, ord=\"fro\")\n    assert ext_scale > 0.0\n    rel_err_ext = np.linalg.norm(\n        K_ext_red - K_ext_fd, ord=\"fro\"\n    ) / ext_scale\n    assert rel_err_ext < 1.0e-6"}]}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Edited", "message": "C:\\Github\\ANYsolver\\tests\\test_nonlinear_beam_shell_slice3.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
