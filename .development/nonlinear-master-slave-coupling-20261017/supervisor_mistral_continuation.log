{"id": "effect-c9e3a0e9-f90a-5e01-b0c8-1e0f1209e9fc", "sessionId": "d77c8371-229c-7034-6088-eaefcc4b4445", "turnId": "turn-6f19a1036e2fefd5642f253cb635b74b", "createdAt": 1792346936788, "updatedAt": 1792346936832, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.write_file", "detail": {"toolName": "file_system.write_file", "display": {"summary": "Writing C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/harness.py", "content": "\"\"\"Slice 3 task harness: bounded, evidenced numerical execution.\n\nUsage (from anywhere):\n  <repo>/.venv/Scripts/python.exe harness.py --name ATTEMPT [--timeout 120]\n      [--cwd DIR] [--allow-reserve] [--hash-input PATH]... [--src-override DIR]\n      [--skip-preflight] -- CMD ARGS...\n\nRecords under evidence/<name>/:\n  receipt.json  command, cwd, selected-source identity + import-origin\n                verification, runtime record, exit/timeout status, precise\n                process-wall seconds, cumulative budget, named test counts\n  preflight.json  effective versions, import origins, threadpool, effective\n                numba DISABLE_JIT state\n  stdout.txt / stderr.txt  full streamed output (preserved on timeout and on\n                any harness exception)\n  running.json  live lock record (removed on completion)\n\nBudget ledger persists in budget.json (allowance 3600 s, final-verification\nreserve 900 s). Every attempt, including failures, timeouts and harness-side\nexceptions, is charged and recorded. One numerical child at a time is enforced\nwith a lock file. When --src-override is given it REPLACES the PYTHONPATH\nsource root (the candidate src is never added), and the receipt verifies the\nactual anysolver import origin against the selected root.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nTASK_DIR = Path(__file__).resolve().parent\nREPO = TASK_DIR.parents[1]\nEVIDENCE = TASK_DIR / \"evidence\"\nBUDGET_FILE = TASK_DIR / \"budget.json\"\nLOCK_FILE = TASK_DIR / \"running.lock\"\nALLOWANCE = 3600.0\nRESERVE = 900.0\n\nIDENTITY_FILES = [\n    \"src/anysolver/corotational.py\",\n    \"src/anysolver/elements.py\",\n    \"src/anysolver/mesh_gen.py\",\n    \"src/anysolver/nonlinear_static.py\",\n    \"src/anysolver/nonlinear_performance.py\",\n    \"tests/test_corotational_work_conjugate.py\",\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\n]\n\nCHILD_ENV = {\n    \"OMP_NUM_THREADS\": \"1\",\n    \"OPENBLAS_NUM_THREADS\": \"1\",\n    \"MKL_NUM_THREADS\": \"1\",\n    \"NUMEXPR_NUM_THREADS\": \"1\",\n    \"NUMBA_NUM_THREADS\": \"1\",\n    \"NUMBA_DISABLE_JIT\": \"1\",\n    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n    \"PYTHONHASHSEED\": \"0\",\n    \"PYTHONNOUSERSITE\": \"1\",\n    \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\": \"1\",\n    \"ANYSOLVER_RUN_RETIRED_PROGRAMME_TESTS\": \"0\",\n}\n\nPREFLIGHT_CODE = r\"\"\"\nimport json, sys\ninfo = {\"python\": sys.version}\ntry:\n    import numpy, scipy\n    info[\"numpy\"] = numpy.__version__\n    info[\"scipy\"] = scipy.__version__\nexcept Exception as exc:\n    info[\"numpy_error\"] = repr(exc)\nfor name in (\"anysolver\", \"anymaterial\", \"anygeometry\", \"anymesher\", \"anyfileio\"):\n    try:\n        mod = __import__(name)\n        info[name] = {\n            \"version\": getattr(mod, \"__version__\", None),\n            \"origin\": getattr(mod, \"__file__\", None),\n        }\n    except Exception as exc:\n        info[name] = {\"error\": repr(exc)}\ntry:\n    import numba\n    info[\"numba\"] = numba.__version__\n    info[\"numba_disable_jit_effective\"] = bool(numba.config.DISABLE_JIT)\nexcept Exception as exc:\n    info[\"numba\"] = None\n    info[\"numba_error\"] = repr(exc)\ntry:\n    from threadpoolctl import threadpool_info\n    info[\"threadpools\"] = threadpool_info()\nexcept Exception:\n    info[\"threadpools\"] = \"unavailable\"\nprint(json.dumps(info))\n\"\"\"\n\n# Named pytest summary parsing: the terminal summary line lists categories in\n# any order (\"2 failed, 60 passed, 1 skipped\", \"60 passed\", \"3 error\", ...).\n_COUNT_CATEGORY = re.compile(r\"(\\d+) (passed|failed|skipped|error|errors|xfailed|xpassed|warning|warnings)\")\n\n\ndef sha256_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef load_budget() -> dict:\n    if BUDGET_FILE.exists():\n        with open(BUDGET_FILE, \"r\", encoding=\"utf-8\") as fh:\n            return json.load(fh)\n    return {\n        \"allowance_seconds\": ALLOWANCE,\n        \"final_verification_reserve_seconds\": RESERVE,\n        \"used_seconds\": 0.0,\n        \"attempts\": [],\n    }\n\n\ndef save_budget(budget: dict) -> None:\n    with open(BUDGET_FILE, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(budget, fh, indent=2)\n\n\ndef parse_counts(stdout: str) -> dict:\n    \"\"\"Parse named pytest counts from the terminal summary line.\n\n    The last short-summary line is used so per-test progress lines cannot\n    shadow a failing summary like \"1 failed, 60 passed\".\n    \"\"\"\n    counts: dict = {}\n    summary_line = \"\"\n    for line in stdout.splitlines():\n        stripped = line.strip()\n        if _COUNT_CATEGORY.search(stripped) and \"passed\" in stripped or (\n            \"failed\" in stripped and _COUNT_CATEGORY.search(stripped)\n        ):\n            if _COUNT_CATEGORY.search(stripped):\n                summary_line = stripped\n    if summary_line:\n        counts[\"summary_line\"] = summary_line\n        for match in _COUNT_CATEGORY.finditer(summary_line):\n            value = int(match.group(1))\n            category = match.group(2).rstrip(\"s\")\n            key = {\"error\": \"errors\", \"warning\": \"warnings\"}.get(category, category)\n            counts[key] = counts.get(key, 0) + value\n    return counts\n\n\ndef kill_tree(pid: int) -> None:\n    subprocess.run(\n        [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\n        capture_output=True,\n        check=False,\n    )\n\n\ndef selected_source_root(args) -> Path:\n    return Path(args.src_override).resolve() if args.src_override else REPO / \"src\"\n\n\ndef selected_tree_hashes(root: Path) -> dict:\n    \"\"\"Hash the identity files of the SELECTED source tree (candidate or override).\"\"\"\n    base = root.parent if root.name == \"src\" else root\n    hashes = {}\n    for rel in IDENTITY_FILES:\n        p = base / rel\n        hashes[str(rel)] = sha256_file(p) if p.exists() else \"MISSING\"\n    return hashes\n\n\ndef verify_import_origin(preflight: dict, root: Path) -> dict:\n    \"\"\"Verify the child's actual anysolver import origin belongs to the selected root.\"\"\"\n    runtime = (preflight or {}).get(\"runtime\") or {}\n    origin = ((runtime.get(\"anysolver\") or {}).get(\"origin\"))\n    if not origin:\n        return {\"anysolver_origin\": None, \"origin_matches_selected_root\": False}\n    root_str = str(root.resolve())\n    return {\n        \"anysolver_origin\": origin,\n        \"selected_source_root\": root_str,\n        \"origin_matches_selected_root\": bool(\n            os.path.abspath(origin).startswith(root_str + os.sep)\n        ),\n    }\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--timeout\", type=float, default=120.0)\n    parser.add_argument(\"--cwd\", default=str(REPO))\n    parser.add_argument(\"--allow-reserve\", action=\"store_true\")\n    parser.add_argument(\"--hash-input\", action=\"append\", default=[])\n    parser.add_argument(\"--skip-preflight\", action=\"store_true\")\n    parser.add_argument(\n        \"--src-override\",\n        default=None,\n        help=\"replace the candidate src PYTHONPATH entry (clean-HEAD attribution runs)\",\n    )\n    parser.add_argument(\"command\", nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n\n    if args.command and args.command[0] == \"--\":\n        args.command = args.command[1:]\n    if not args.command:\n        parser.error(\"no command given\")\n\n    budget = load_budget()\n    used = float(budget[\"used_seconds\"])\n    remaining = ALLOWANCE - used\n    available = remaining - RESERVE\n    if not args.allow_reserve and args.timeout > available:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds available non-reserve \"\n            f\"budget {available:.1f}s (used {used:.1f}s of {ALLOWANCE}s, \"\n            f\"reserve {RESERVE}s). Use --allow-reserve only for final verification.\",\n            file=sys.stderr,\n        )\n        return 2\n    if args.timeout > remaining:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds total remaining {remaining:.1f}s.\",\n            file=sys.stderr,\n        )\n        return 2\n\n    if LOCK_FILE.exists():\n        try:\n            live = json.loads(LOCK_FILE.read_text(encoding=\"utf-8\"))\n        except Exception:\n            live = None\n        print(\n            f\"REFUSED: another numerical child appears active (lock: {live}).\",\n            file=sys.stderr,\n        )\n        return 3\n\n    out_dir = EVIDENCE / args.name\n    if out_dir.exists():\n        print(f\"REFUSED: evidence path {out_dir} already exists.\", file=sys.stderr)\n        return 4\n    out_dir.mkdir(parents=True)\n\n    LOCK_FILE.write_text(\n        json.dumps(\n            {\n                \"name\": args.name,\n                \"pid\": os.getpid(),\n                \"started_utc\": datetime.now(timezone.utc).isoformat(),\n            }\n        ),\n        encoding=\"utf-8\",\n    )\n\n    root = selected_source_root(args)\n    env = dict(os.environ)\n    env.update(CHILD_ENV)\n    # Exact import routing: the selected source root REPLACES the inherited\n    # PYTHONPATH so a clean-HEAD attribution can never fall back to the\n    # candidate tree (or vice versa).\n    env[\"PYTHONPATH\"] = str(root)\n\n    hashes = selected_tree_hashes(root)\n    hashes[\"selected_root\"] = str(root)\n    for extra in args.hash_input:\n        p = Path(extra)\n        hashes[str(p)] = sha256_file(p) if p.exists() else \"MISSING\"\n\n    started_utc = datetime.now(timezone.utc).isoformat()\n    wall_total = 0.0\n    status = \"ERROR\"\n    exit_code = None\n    preflight = None\n    proc = None\n    stdout_path = out_dir / \"stdout.txt\"\n    stderr_path = out_dir / \"stderr.txt\"\n    harness_error = None\n    receipt_written = False\n\n    try:\n        if not args.skip_preflight:\n            pre_out = out_dir / \"preflight_stdout.txt\"\n            pre_err_out = out_dir / \"preflight_stderr.txt\"\n            t0 = time.perf_counter()\n            with open(pre_out, \"wb\") as fh, open(pre_err_out, \"wb\") as err_fh:\n                proc = subprocess.Popen(\n                    [sys.executable, \"-c\", PREFLIGHT_CODE],\n                    stdout=fh,\n                    stderr=err_fh,\n                    env=env,\n                    cwd=args.cwd,\n                )\n                try:\n                    proc.wait(timeout=max(10.0, args.timeout))\n                except subprocess.TimeoutExpired:\n                    kill_tree(proc.pid)\n                    try:\n                        proc.wait(timeout=30)\n                    except subprocess.TimeoutExpired:\n                        pass\n            pre_wall = time.perf_counter() - t0\n            wall_total += pre_wall\n            preflight = {\n                \"wall_seconds\": pre_wall,\n                \"exit_code\": proc.returncode,\n                \"stderr\": pre_err_out.read_text(encoding=\"utf-8\", errors=\"replace\")[-4000:],\n            }\n            try:\n                preflight[\"runtime\"] = json.loads(pre_out.read_text(encoding=\"utf-8\"))\n            except Exception as exc:\n                preflight[\"runtime_parse_error\"] = repr(exc)\n            preflight[\"import_origin_check\"] = verify_import_origin(preflight, root)\n            (out_dir / \"preflight.json\").write_text(\n                json.dumps(preflight, indent=2), encoding=\"utf-8\"\n            )\n        proc = None\n\n        t0 = time.perf_counter()\n        with open(stdout_path, \"wb\") as out_fh, open(stderr_path, \"wb\") as err_fh:\n            proc = subprocess.Popen(\n                args.command,\n                stdout=out_fh,\n                stderr=err_fh,\n                env=env,\n                cwd=args.cwd,\n            )\n            try:\n                proc.wait(timeout=max(1.0, args.timeout - wall_total))\n                status = \"EXIT\" if proc.returncode == 0 else f\"EXIT_{proc.returncode}\"\n                exit_code = proc.returncode\n            except subprocess.TimeoutExpired:\n                kill_tree(proc.pid)\n                try:\n                    proc.wait(timeout=30)\n                except subprocess.TimeoutExpired:\n                    pass\n                status = \"TIMEOUT\"\n                exit_code = proc.returncode\n        proc = None\n        main_wall = time.perf_counter() - t0\n        wall_total += main_wall\n\n        stdout_text = (\n            stdout_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n            if stdout_path.exists()\n            else \"\"\n        )\n        receipt = {\n            \"name\": args.name,\n            \"command\": args.command,\n            \"cwd\": str(Path(args.cwd)),\n            \"started_utc\": started_utc,\n            \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n            \"status\": status,\n            \"exit_code\": exit_code,\n            \"timeout_seconds\": args.timeout,\n            \"process_wall_seconds\": wall_total,\n            \"main_wall_seconds\": main_wall,\n            \"identity_hashes\": hashes,\n            \"child_env\": CHILD_ENV,\n            \"preflight_included\": preflight is not None,\n            \"import_origin_check\": (\n                (preflight or {}).get(\"import_origin_check\")\n                if preflight\n                else verify_import_origin(None, root)\n            ),\n            \"counts\": parse_counts(stdout_text),\n            \"head\": subprocess.run(\n                [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                capture_output=True,\n                text=True,\n            ).stdout.strip(),\n        }\n        (out_dir / \"receipt.json\").write_text(\n            json.dumps(receipt, indent=2), encoding=\"utf-8\"\n        )\n        receipt_written = True\n\n        budget[\"used_seconds\"] = used + wall_total\n        budget[\"attempts\"].append(\n            {\n                \"name\": args.name,\n                \"status\": status,\n                \"wall_seconds\": wall_total,\n                \"cumulative_used\": budget[\"used_seconds\"],\n                \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                \"started_utc\": started_utc,\n            }\n        )\n        save_budget(budget)\n        print(\n            f\"[harness] {args.name}: {status} wall={wall_total:.2f}s \"\n            f\"used={budget['used_seconds']:.1f}s \"\n            f\"remaining={ALLOWANCE - budget['used_seconds']:.1f}s\"\n        )\n        return 0 if status == \"EXIT\" else 1\n    except Exception as exc:  # noqa: BLE001 - accounting must survive any failure\n        harness_error = f\"{type(exc).__name__}: {exc}\"\n        status = \"HARNESS_ERROR\"\n        raise\n    finally:\n        # Unconditional process-tree cleanup and accounting. Any harness-side\n        # exception still writes a receipt, charges the measured wall time and\n        # removes the lock, preserving partial stdout/stderr.\n        if proc is not None and proc.poll() is None:\n            kill_tree(proc.pid)\n            try:\n                proc.wait(timeout=10)\n            except subprocess.TimeoutExpired:\n                pass\n        if not receipt_written:\n            try:\n                wall_total_final = wall_total if wall_total > 0 else 0.0\n                partial = {\n                    \"name\": args.name,\n                    \"command\": args.command,\n                    \"cwd\": str(Path(args.cwd)),\n                    \"started_utc\": started_utc,\n                    \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n                    \"status\": status,\n                    \"exit_code\": exit_code,\n                    \"timeout_seconds\": args.timeout,\n                    \"process_wall_seconds\": wall_total_final,\n                    \"identity_hashes\": hashes,\n                    \"child_env\": CHILD_ENV,\n                    \"preflight_included\": preflight is not None,\n                    \"import_origin_check\": (\n                        (preflight or {}).get(\"import_origin_check\")\n                        if preflight\n                        else verify_import_origin(None, root)\n                    ),\n                    \"harness_error\": harness_error,\n                    \"partial_accounting\": True,\n                    \"head\": subprocess.run(\n                        [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                        capture_output=True,\n                        text=True,\n                    ).stdout.strip(),\n                }\n                (out_dir / \"receipt.json\").write_text(\n                    json.dumps(partial, indent=2), encoding=\"utf-8\"\n                )\n                budget[\"used_seconds\"] = used + wall_total_final\n                budget[\"attempts\"].append(\n                    {\n                        \"name\": args.name,\n                        \"status\": status,\n                        \"wall_seconds\": wall_total_final,\n                        \"cumulative_used\": budget[\"used_seconds\"],\n                        \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                        \"started_utc\": started_utc,\n                    }\n                )\n                save_budget(budget)\n                print(\n                    f\"[harness] {args.name}: {status} (partial accounting) \"\n                    f\"wall={wall_total_final:.2f}s \"\n                    f\"used={budget['used_seconds']:.1f}s\",\n                    file=sys.stderr,\n                )\n            except Exception as exc:  # noqa: BLE001\n                print(f\"[harness] accounting failure: {exc!r}\", file=sys.stderr)\n        try:\n            LOCK_FILE.unlink()\n        except FileNotFoundError:\n            pass\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n", "suffix": "", "verb": "Creating", "message": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/harness.py", "settledVerb": "Created", "settledMessage": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/harness.py", "statusText": "Writing file"}, "kind": "file_write", "input": {"filePath": "C:/Github/ANYsolver/.development/nonlinear-master-slave-coupling-20261017/harness.py", "content": "\"\"\"Slice 3 task harness: bounded, evidenced numerical execution.\n\nUsage (from anywhere):\n  <repo>/.venv/Scripts/python.exe harness.py --name ATTEMPT [--timeout 120]\n      [--cwd DIR] [--allow-reserve] [--hash-input PATH]... [--src-override DIR]\n      [--skip-preflight] -- CMD ARGS...\n\nRecords under evidence/<name>/:\n  receipt.json  command, cwd, selected-source identity + import-origin\n                verification, runtime record, exit/timeout status, precise\n                process-wall seconds, cumulative budget, named test counts\n  preflight.json  effective versions, import origins, threadpool, effective\n                numba DISABLE_JIT state\n  stdout.txt / stderr.txt  full streamed output (preserved on timeout and on\n                any harness exception)\n  running.json  live lock record (removed on completion)\n\nBudget ledger persists in budget.json (allowance 3600 s, final-verification\nreserve 900 s). Every attempt, including failures, timeouts and harness-side\nexceptions, is charged and recorded. One numerical child at a time is enforced\nwith a lock file. When --src-override is given it REPLACES the PYTHONPATH\nsource root (the candidate src is never added), and the receipt verifies the\nactual anysolver import origin against the selected root.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nTASK_DIR = Path(__file__).resolve().parent\nREPO = TASK_DIR.parents[1]\nEVIDENCE = TASK_DIR / \"evidence\"\nBUDGET_FILE = TASK_DIR / \"budget.json\"\nLOCK_FILE = TASK_DIR / \"running.lock\"\nALLOWANCE = 3600.0\nRESERVE = 900.0\n\nIDENTITY_FILES = [\n    \"src/anysolver/corotational.py\",\n    \"src/anysolver/elements.py\",\n    \"src/anysolver/mesh_gen.py\",\n    \"src/anysolver/nonlinear_static.py\",\n    \"src/anysolver/nonlinear_performance.py\",\n    \"tests/test_corotational_work_conjugate.py\",\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\n]\n\nCHILD_ENV = {\n    \"OMP_NUM_THREADS\": \"1\",\n    \"OPENBLAS_NUM_THREADS\": \"1\",\n    \"MKL_NUM_THREADS\": \"1\",\n    \"NUMEXPR_NUM_THREADS\": \"1\",\n    \"NUMBA_NUM_THREADS\": \"1\",\n    \"NUMBA_DISABLE_JIT\": \"1\",\n    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n    \"PYTHONHASHSEED\": \"0\",\n    \"PYTHONNOUSERSITE\": \"1\",\n    \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\": \"1\",\n    \"ANYSOLVER_RUN_RETIRED_PROGRAMME_TESTS\": \"0\",\n}\n\nPREFLIGHT_CODE = r\"\"\"\nimport json, sys\ninfo = {\"python\": sys.version}\ntry:\n    import numpy, scipy\n    info[\"numpy\"] = numpy.__version__\n    info[\"scipy\"] = scipy.__version__\nexcept Exception as exc:\n    info[\"numpy_error\"] = repr(exc)\nfor name in (\"anysolver\", \"anymaterial\", \"anygeometry\", \"anymesher\", \"anyfileio\"):\n    try:\n        mod = __import__(name)\n        info[name] = {\n            \"version\": getattr(mod, \"__version__\", None),\n            \"origin\": getattr(mod, \"__file__\", None),\n        }\n    except Exception as exc:\n        info[name] = {\"error\": repr(exc)}\ntry:\n    import numba\n    info[\"numba\"] = numba.__version__\n    info[\"numba_disable_jit_effective\"] = bool(numba.config.DISABLE_JIT)\nexcept Exception as exc:\n    info[\"numba\"] = None\n    info[\"numba_error\"] = repr(exc)\ntry:\n    from threadpoolctl import threadpool_info\n    info[\"threadpools\"] = threadpool_info()\nexcept Exception:\n    info[\"threadpools\"] = \"unavailable\"\nprint(json.dumps(info))\n\"\"\"\n\n# Named pytest summary parsing: the terminal summary line lists categories in\n# any order (\"2 failed, 60 passed, 1 skipped\", \"60 passed\", \"3 error\", ...).\n_COUNT_CATEGORY = re.compile(r\"(\\d+) (passed|failed|skipped|error|errors|xfailed|xpassed|warning|warnings)\")\n\n\ndef sha256_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef load_budget() -> dict:\n    if BUDGET_FILE.exists():\n        with open(BUDGET_FILE, \"r\", encoding=\"utf-8\") as fh:\n            return json.load(fh)\n    return {\n        \"allowance_seconds\": ALLOWANCE,\n        \"final_verification_reserve_seconds\": RESERVE,\n        \"used_seconds\": 0.0,\n        \"attempts\": [],\n    }\n\n\ndef save_budget(budget: dict) -> None:\n    with open(BUDGET_FILE, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(budget, fh, indent=2)\n\n\ndef parse_counts(stdout: str) -> dict:\n    \"\"\"Parse named pytest counts from the terminal summary line.\n\n    The last short-summary line is used so per-test progress lines cannot\n    shadow a failing summary like \"1 failed, 60 passed\".\n    \"\"\"\n    counts: dict = {}\n    summary_line = \"\"\n    for line in stdout.splitlines():\n        stripped = line.strip()\n        if _COUNT_CATEGORY.search(stripped) and \"passed\" in stripped or (\n            \"failed\" in stripped and _COUNT_CATEGORY.search(stripped)\n        ):\n            if _COUNT_CATEGORY.search(stripped):\n                summary_line = stripped\n    if summary_line:\n        counts[\"summary_line\"] = summary_line\n        for match in _COUNT_CATEGORY.finditer(summary_line):\n            value = int(match.group(1))\n            category = match.group(2).rstrip(\"s\")\n            key = {\"error\": \"errors\", \"warning\": \"warnings\"}.get(category, category)\n            counts[key] = counts.get(key, 0) + value\n    return counts\n\n\ndef kill_tree(pid: int) -> None:\n    subprocess.run(\n        [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\n        capture_output=True,\n        check=False,\n    )\n\n\ndef selected_source_root(args) -> Path:\n    return Path(args.src_override).resolve() if args.src_override else REPO / \"src\"\n\n\ndef selected_tree_hashes(root: Path) -> dict:\n    \"\"\"Hash the identity files of the SELECTED source tree (candidate or override).\"\"\"\n    base = root.parent if root.name == \"src\" else root\n    hashes = {}\n    for rel in IDENTITY_FILES:\n        p = base / rel\n        hashes[str(rel)] = sha256_file(p) if p.exists() else \"MISSING\"\n    return hashes\n\n\ndef verify_import_origin(preflight: dict, root: Path) -> dict:\n    \"\"\"Verify the child's actual anysolver import origin belongs to the selected root.\"\"\"\n    runtime = (preflight or {}).get(\"runtime\") or {}\n    origin = ((runtime.get(\"anysolver\") or {}).get(\"origin\"))\n    if not origin:\n        return {\"anysolver_origin\": None, \"origin_matches_selected_root\": False}\n    root_str = str(root.resolve())\n    return {\n        \"anysolver_origin\": origin,\n        \"selected_source_root\": root_str,\n        \"origin_matches_selected_root\": bool(\n            os.path.abspath(origin).startswith(root_str + os.sep)\n        ),\n    }\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--timeout\", type=float, default=120.0)\n    parser.add_argument(\"--cwd\", default=str(REPO))\n    parser.add_argument(\"--allow-reserve\", action=\"store_true\")\n    parser.add_argument(\"--hash-input\", action=\"append\", default=[])\n    parser.add_argument(\"--skip-preflight\", action=\"store_true\")\n    parser.add_argument(\n        \"--src-override\",\n        default=None,\n        help=\"replace the candidate src PYTHONPATH entry (clean-HEAD attribution runs)\",\n    )\n    parser.add_argument(\"command\", nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n\n    if args.command and args.command[0] == \"--\":\n        args.command = args.command[1:]\n    if not args.command:\n        parser.error(\"no command given\")\n\n    budget = load_budget()\n    used = float(budget[\"used_seconds\"])\n    remaining = ALLOWANCE - used\n    available = remaining - RESERVE\n    if not args.allow_reserve and args.timeout > available:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds available non-reserve \"\n            f\"budget {available:.1f}s (used {used:.1f}s of {ALLOWANCE}s, \"\n            f\"reserve {RESERVE}s). Use --allow-reserve only for final verification.\",\n            file=sys.stderr,\n        )\n        return 2\n    if args.timeout > remaining:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds total remaining {remaining:.1f}s.\",\n            file=sys.stderr,\n        )\n        return 2\n\n    if LOCK_FILE.exists():\n        try:\n            live = json.loads(LOCK_FILE.read_text(encoding=\"utf-8\"))\n        except Exception:\n            live = None\n        print(\n            f\"REFUSED: another numerical child appears active (lock: {live}).\",\n            file=sys.stderr,\n        )\n        return 3\n\n    out_dir = EVIDENCE / args.name\n    if out_dir.exists():\n        print(f\"REFUSED: evidence path {out_dir} already exists.\", file=sys.stderr)\n        return 4\n    out_dir.mkdir(parents=True)\n\n    LOCK_FILE.write_text(\n        json.dumps(\n            {\n                \"name\": args.name,\n                \"pid\": os.getpid(),\n                \"started_utc\": datetime.now(timezone.utc).isoformat(),\n            }\n        ),\n        encoding=\"utf-8\",\n    )\n\n    root = selected_source_root(args)\n    env = dict(os.environ)\n    env.update(CHILD_ENV)\n    # Exact import routing: the selected source root REPLACES the inherited\n    # PYTHONPATH so a clean-HEAD attribution can never fall back to the\n    # candidate tree (or vice versa).\n    env[\"PYTHONPATH\"] = str(root)\n\n    hashes = selected_tree_hashes(root)\n    hashes[\"selected_root\"] = str(root)\n    for extra in args.hash_input:\n        p = Path(extra)\n        hashes[str(p)] = sha256_file(p) if p.exists() else \"MISSING\"\n\n    started_utc = datetime.now(timezone.utc).isoformat()\n    wall_total = 0.0\n    status = \"ERROR\"\n    exit_code = None\n    preflight = None\n    proc = None\n    stdout_path = out_dir / \"stdout.txt\"\n    stderr_path = out_dir / \"stderr.txt\"\n    harness_error = None\n    receipt_written = False\n\n    try:\n        if not args.skip_preflight:\n            pre_out = out_dir / \"preflight_stdout.txt\"\n            pre_err_out = out_dir / \"preflight_stderr.txt\"\n            t0 = time.perf_counter()\n            with open(pre_out, \"wb\") as fh, open(pre_err_out, \"wb\") as err_fh:\n                proc = subprocess.Popen(\n                    [sys.executable, \"-c\", PREFLIGHT_CODE],\n                    stdout=fh,\n                    stderr=err_fh,\n                    env=env,\n                    cwd=args.cwd,\n                )\n                try:\n                    proc.wait(timeout=max(10.0, args.timeout))\n                except subprocess.TimeoutExpired:\n                    kill_tree(proc.pid)\n                    try:\n                        proc.wait(timeout=30)\n                    except subprocess.TimeoutExpired:\n                        pass\n            pre_wall = time.perf_counter() - t0\n            wall_total += pre_wall\n            preflight = {\n                \"wall_seconds\": pre_wall,\n                \"exit_code\": proc.returncode,\n                \"stderr\": pre_err_out.read_text(encoding=\"utf-8\", errors=\"replace\")[-4000:],\n            }\n            try:\n                preflight[\"runtime\"] = json.loads(pre_out.read_text(encoding=\"utf-8\"))\n            except Exception as exc:\n                preflight[\"runtime_parse_error\"] = repr(exc)\n            preflight[\"import_origin_check\"] = verify_import_origin(preflight, root)\n            (out_dir / \"preflight.json\").write_text(\n                json.dumps(preflight, indent=2), encoding=\"utf-8\"\n            )\n        proc = None\n\n        t0 = time.perf_counter()\n        with open(stdout_path, \"wb\") as out_fh, open(stderr_path, \"wb\") as err_fh:\n            proc = subprocess.Popen(\n                args.command,\n                stdout=out_fh,\n                stderr=err_fh,\n                env=env,\n                cwd=args.cwd,\n            )\n            try:\n                proc.wait(timeout=max(1.0, args.timeout - wall_total))\n                status = \"EXIT\" if proc.returncode == 0 else f\"EXIT_{proc.returncode}\"\n                exit_code = proc.returncode\n            except subprocess.TimeoutExpired:\n                kill_tree(proc.pid)\n                try:\n                    proc.wait(timeout=30)\n                except subprocess.TimeoutExpired:\n                    pass\n                status = \"TIMEOUT\"\n                exit_code = proc.returncode\n        proc = None\n        main_wall = time.perf_counter() - t0\n        wall_total += main_wall\n\n        stdout_text = (\n            stdout_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n            if stdout_path.exists()\n            else \"\"\n        )\n        receipt = {\n            \"name\": args.name,\n            \"command\": args.command,\n            \"cwd\": str(Path(args.cwd)),\n            \"started_utc\": started_utc,\n            \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n            \"status\": status,\n            \"exit_code\": exit_code,\n            \"timeout_seconds\": args.timeout,\n            \"process_wall_seconds\": wall_total,\n            \"main_wall_seconds\": main_wall,\n            \"identity_hashes\": hashes,\n            \"child_env\": CHILD_ENV,\n            \"preflight_included\": preflight is not None,\n            \"import_origin_check\": (\n                (preflight or {}).get(\"import_origin_check\")\n                if preflight\n                else verify_import_origin(None, root)\n            ),\n            \"counts\": parse_counts(stdout_text),\n            \"head\": subprocess.run(\n                [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                capture_output=True,\n                text=True,\n            ).stdout.strip(),\n        }\n        (out_dir / \"receipt.json\").write_text(\n            json.dumps(receipt, indent=2), encoding=\"utf-8\"\n        )\n        receipt_written = True\n\n        budget[\"used_seconds\"] = used + wall_total\n        budget[\"attempts\"].append(\n            {\n                \"name\": args.name,\n                \"status\": status,\n                \"wall_seconds\": wall_total,\n                \"cumulative_used\": budget[\"used_seconds\"],\n                \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                \"started_utc\": started_utc,\n            }\n        )\n        save_budget(budget)\n        print(\n            f\"[harness] {args.name}: {status} wall={wall_total:.2f}s \"\n            f\"used={budget['used_seconds']:.1f}s \"\n            f\"remaining={ALLOWANCE - budget['used_seconds']:.1f}s\"\n        )\n        return 0 if status == \"EXIT\" else 1\n    except Exception as exc:  # noqa: BLE001 - accounting must survive any failure\n        harness_error = f\"{type(exc).__name__}: {exc}\"\n        status = \"HARNESS_ERROR\"\n        raise\n    finally:\n        # Unconditional process-tree cleanup and accounting. Any harness-side\n        # exception still writes a receipt, charges the measured wall time and\n        # removes the lock, preserving partial stdout/stderr.\n        if proc is not None and proc.poll() is None:\n            kill_tree(proc.pid)\n            try:\n                proc.wait(timeout=10)\n            except subprocess.TimeoutExpired:\n                pass\n        if not receipt_written:\n            try:\n                wall_total_final = wall_total if wall_total > 0 else 0.0\n                partial = {\n                    \"name\": args.name,\n                    \"command\": args.command,\n                    \"cwd\": str(Path(args.cwd)),\n                    \"started_utc\": started_utc,\n                    \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n                    \"status\": status,\n                    \"exit_code\": exit_code,\n                    \"timeout_seconds\": args.timeout,\n                    \"process_wall_seconds\": wall_total_final,\n                    \"identity_hashes\": hashes,\n                    \"child_env\": CHILD_ENV,\n                    \"preflight_included\": preflight is not None,\n                    \"import_origin_check\": (\n                        (preflight or {}).get(\"import_origin_check\")\n                        if preflight\n                        else verify_import_origin(None, root)\n                    ),\n                    \"harness_error\": harness_error,\n                    \"partial_accounting\": True,\n                    \"head\": subprocess.run(\n                        [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                        capture_output=True,\n                        text=True,\n                    ).stdout.strip(),\n                }\n                (out_dir / \"receipt.json\").write_text(\n                    json.dumps(partial, indent=2), encoding=\"utf-8\"\n                )\n                budget[\"used_seconds\"] = used + wall_total_final\n                budget[\"attempts\"].append(\n                    {\n                        \"name\": args.name,\n                        \"status\": status,\n                        \"wall_seconds\": wall_total_final,\n                        \"cumulative_used\": budget[\"used_seconds\"],\n                        \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                        \"started_utc\": started_utc,\n                    }\n                )\n                save_budget(budget)\n                print(\n                    f\"[harness] {args.name}: {status} (partial accounting) \"\n                    f\"wall={wall_total_final:.2f}s \"\n                    f\"used={budget['used_seconds']:.1f}s\",\n                    file=sys.stderr,\n                )\n            except Exception as exc:  # noqa: BLE001\n                print(f\"[harness] accounting failure: {exc!r}\", file=sys.stderr)\n        try:\n            LOCK_FILE.unlink()\n        except FileNotFoundError:\n            pass\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "content": "\"\"\"Slice 3 task harness: bounded, evidenced numerical execution.\n\nUsage (from anywhere):\n  <repo>/.venv/Scripts/python.exe harness.py --name ATTEMPT [--timeout 120]\n      [--cwd DIR] [--allow-reserve] [--hash-input PATH]... [--src-override DIR]\n      [--skip-preflight] -- CMD ARGS...\n\nRecords under evidence/<name>/:\n  receipt.json  command, cwd, selected-source identity + import-origin\n                verification, runtime record, exit/timeout status, precise\n                process-wall seconds, cumulative budget, named test counts\n  preflight.json  effective versions, import origins, threadpool, effective\n                numba DISABLE_JIT state\n  stdout.txt / stderr.txt  full streamed output (preserved on timeout and on\n                any harness exception)\n  running.json  live lock record (removed on completion)\n\nBudget ledger persists in budget.json (allowance 3600 s, final-verification\nreserve 900 s). Every attempt, including failures, timeouts and harness-side\nexceptions, is charged and recorded. One numerical child at a time is enforced\nwith a lock file. When --src-override is given it REPLACES the PYTHONPATH\nsource root (the candidate src is never added), and the receipt verifies the\nactual anysolver import origin against the selected root.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\nTASK_DIR = Path(__file__).resolve().parent\nREPO = TASK_DIR.parents[1]\nEVIDENCE = TASK_DIR / \"evidence\"\nBUDGET_FILE = TASK_DIR / \"budget.json\"\nLOCK_FILE = TASK_DIR / \"running.lock\"\nALLOWANCE = 3600.0\nRESERVE = 900.0\n\nIDENTITY_FILES = [\n    \"src/anysolver/corotational.py\",\n    \"src/anysolver/elements.py\",\n    \"src/anysolver/mesh_gen.py\",\n    \"src/anysolver/nonlinear_static.py\",\n    \"src/anysolver/nonlinear_performance.py\",\n    \"tests/test_corotational_work_conjugate.py\",\n    \"tests/test_nonlinear_beam_shell_coupling.py\",\n]\n\nCHILD_ENV = {\n    \"OMP_NUM_THREADS\": \"1\",\n    \"OPENBLAS_NUM_THREADS\": \"1\",\n    \"MKL_NUM_THREADS\": \"1\",\n    \"NUMEXPR_NUM_THREADS\": \"1\",\n    \"NUMBA_NUM_THREADS\": \"1\",\n    \"NUMBA_DISABLE_JIT\": \"1\",\n    \"PYTHONDONTWRITEBYTECODE\": \"1\",\n    \"PYTHONHASHSEED\": \"0\",\n    \"PYTHONNOUSERSITE\": \"1\",\n    \"PYTEST_DISABLE_PLUGIN_AUTOLOAD\": \"1\",\n    \"ANYSOLVER_RUN_RETIRED_PROGRAMME_TESTS\": \"0\",\n}\n\nPREFLIGHT_CODE = r\"\"\"\nimport json, sys\ninfo = {\"python\": sys.version}\ntry:\n    import numpy, scipy\n    info[\"numpy\"] = numpy.__version__\n    info[\"scipy\"] = scipy.__version__\nexcept Exception as exc:\n    info[\"numpy_error\"] = repr(exc)\nfor name in (\"anysolver\", \"anymaterial\", \"anygeometry\", \"anymesher\", \"anyfileio\"):\n    try:\n        mod = __import__(name)\n        info[name] = {\n            \"version\": getattr(mod, \"__version__\", None),\n            \"origin\": getattr(mod, \"__file__\", None),\n        }\n    except Exception as exc:\n        info[name] = {\"error\": repr(exc)}\ntry:\n    import numba\n    info[\"numba\"] = numba.__version__\n    info[\"numba_disable_jit_effective\"] = bool(numba.config.DISABLE_JIT)\nexcept Exception as exc:\n    info[\"numba\"] = None\n    info[\"numba_error\"] = repr(exc)\ntry:\n    from threadpoolctl import threadpool_info\n    info[\"threadpools\"] = threadpool_info()\nexcept Exception:\n    info[\"threadpools\"] = \"unavailable\"\nprint(json.dumps(info))\n\"\"\"\n\n# Named pytest summary parsing: the terminal summary line lists categories in\n# any order (\"2 failed, 60 passed, 1 skipped\", \"60 passed\", \"3 error\", ...).\n_COUNT_CATEGORY = re.compile(r\"(\\d+) (passed|failed|skipped|error|errors|xfailed|xpassed|warning|warnings)\")\n\n\ndef sha256_file(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as fh:\n        for chunk in iter(lambda: fh.read(1 << 20), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()\n\n\ndef load_budget() -> dict:\n    if BUDGET_FILE.exists():\n        with open(BUDGET_FILE, \"r\", encoding=\"utf-8\") as fh:\n            return json.load(fh)\n    return {\n        \"allowance_seconds\": ALLOWANCE,\n        \"final_verification_reserve_seconds\": RESERVE,\n        \"used_seconds\": 0.0,\n        \"attempts\": [],\n    }\n\n\ndef save_budget(budget: dict) -> None:\n    with open(BUDGET_FILE, \"w\", encoding=\"utf-8\") as fh:\n        json.dump(budget, fh, indent=2)\n\n\ndef parse_counts(stdout: str) -> dict:\n    \"\"\"Parse named pytest counts from the terminal summary line.\n\n    The last short-summary line is used so per-test progress lines cannot\n    shadow a failing summary like \"1 failed, 60 passed\".\n    \"\"\"\n    counts: dict = {}\n    summary_line = \"\"\n    for line in stdout.splitlines():\n        stripped = line.strip()\n        if _COUNT_CATEGORY.search(stripped) and \"passed\" in stripped or (\n            \"failed\" in stripped and _COUNT_CATEGORY.search(stripped)\n        ):\n            if _COUNT_CATEGORY.search(stripped):\n                summary_line = stripped\n    if summary_line:\n        counts[\"summary_line\"] = summary_line\n        for match in _COUNT_CATEGORY.finditer(summary_line):\n            value = int(match.group(1))\n            category = match.group(2).rstrip(\"s\")\n            key = {\"error\": \"errors\", \"warning\": \"warnings\"}.get(category, category)\n            counts[key] = counts.get(key, 0) + value\n    return counts\n\n\ndef kill_tree(pid: int) -> None:\n    subprocess.run(\n        [\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)],\n        capture_output=True,\n        check=False,\n    )\n\n\ndef selected_source_root(args) -> Path:\n    return Path(args.src_override).resolve() if args.src_override else REPO / \"src\"\n\n\ndef selected_tree_hashes(root: Path) -> dict:\n    \"\"\"Hash the identity files of the SELECTED source tree (candidate or override).\"\"\"\n    base = root.parent if root.name == \"src\" else root\n    hashes = {}\n    for rel in IDENTITY_FILES:\n        p = base / rel\n        hashes[str(rel)] = sha256_file(p) if p.exists() else \"MISSING\"\n    return hashes\n\n\ndef verify_import_origin(preflight: dict, root: Path) -> dict:\n    \"\"\"Verify the child's actual anysolver import origin belongs to the selected root.\"\"\"\n    runtime = (preflight or {}).get(\"runtime\") or {}\n    origin = ((runtime.get(\"anysolver\") or {}).get(\"origin\"))\n    if not origin:\n        return {\"anysolver_origin\": None, \"origin_matches_selected_root\": False}\n    root_str = str(root.resolve())\n    return {\n        \"anysolver_origin\": origin,\n        \"selected_source_root\": root_str,\n        \"origin_matches_selected_root\": bool(\n            os.path.abspath(origin).startswith(root_str + os.sep)\n        ),\n    }\n\n\ndef main() -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--timeout\", type=float, default=120.0)\n    parser.add_argument(\"--cwd\", default=str(REPO))\n    parser.add_argument(\"--allow-reserve\", action=\"store_true\")\n    parser.add_argument(\"--hash-input\", action=\"append\", default=[])\n    parser.add_argument(\"--skip-preflight\", action=\"store_true\")\n    parser.add_argument(\n        \"--src-override\",\n        default=None,\n        help=\"replace the candidate src PYTHONPATH entry (clean-HEAD attribution runs)\",\n    )\n    parser.add_argument(\"command\", nargs=argparse.REMAINDER)\n    args = parser.parse_args()\n\n    if args.command and args.command[0] == \"--\":\n        args.command = args.command[1:]\n    if not args.command:\n        parser.error(\"no command given\")\n\n    budget = load_budget()\n    used = float(budget[\"used_seconds\"])\n    remaining = ALLOWANCE - used\n    available = remaining - RESERVE\n    if not args.allow_reserve and args.timeout > available:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds available non-reserve \"\n            f\"budget {available:.1f}s (used {used:.1f}s of {ALLOWANCE}s, \"\n            f\"reserve {RESERVE}s). Use --allow-reserve only for final verification.\",\n            file=sys.stderr,\n        )\n        return 2\n    if args.timeout > remaining:\n        print(\n            f\"REFUSED: timeout {args.timeout}s exceeds total remaining {remaining:.1f}s.\",\n            file=sys.stderr,\n        )\n        return 2\n\n    if LOCK_FILE.exists():\n        try:\n            live = json.loads(LOCK_FILE.read_text(encoding=\"utf-8\"))\n        except Exception:\n            live = None\n        print(\n            f\"REFUSED: another numerical child appears active (lock: {live}).\",\n            file=sys.stderr,\n        )\n        return 3\n\n    out_dir = EVIDENCE / args.name\n    if out_dir.exists():\n        print(f\"REFUSED: evidence path {out_dir} already exists.\", file=sys.stderr)\n        return 4\n    out_dir.mkdir(parents=True)\n\n    LOCK_FILE.write_text(\n        json.dumps(\n            {\n                \"name\": args.name,\n                \"pid\": os.getpid(),\n                \"started_utc\": datetime.now(timezone.utc).isoformat(),\n            }\n        ),\n        encoding=\"utf-8\",\n    )\n\n    root = selected_source_root(args)\n    env = dict(os.environ)\n    env.update(CHILD_ENV)\n    # Exact import routing: the selected source root REPLACES the inherited\n    # PYTHONPATH so a clean-HEAD attribution can never fall back to the\n    # candidate tree (or vice versa).\n    env[\"PYTHONPATH\"] = str(root)\n\n    hashes = selected_tree_hashes(root)\n    hashes[\"selected_root\"] = str(root)\n    for extra in args.hash_input:\n        p = Path(extra)\n        hashes[str(p)] = sha256_file(p) if p.exists() else \"MISSING\"\n\n    started_utc = datetime.now(timezone.utc).isoformat()\n    wall_total = 0.0\n    status = \"ERROR\"\n    exit_code = None\n    preflight = None\n    proc = None\n    stdout_path = out_dir / \"stdout.txt\"\n    stderr_path = out_dir / \"stderr.txt\"\n    harness_error = None\n    receipt_written = False\n\n    try:\n        if not args.skip_preflight:\n            pre_out = out_dir / \"preflight_stdout.txt\"\n            pre_err_out = out_dir / \"preflight_stderr.txt\"\n            t0 = time.perf_counter()\n            with open(pre_out, \"wb\") as fh, open(pre_err_out, \"wb\") as err_fh:\n                proc = subprocess.Popen(\n                    [sys.executable, \"-c\", PREFLIGHT_CODE],\n                    stdout=fh,\n                    stderr=err_fh,\n                    env=env,\n                    cwd=args.cwd,\n                )\n                try:\n                    proc.wait(timeout=max(10.0, args.timeout))\n                except subprocess.TimeoutExpired:\n                    kill_tree(proc.pid)\n                    try:\n                        proc.wait(timeout=30)\n                    except subprocess.TimeoutExpired:\n                        pass\n            pre_wall = time.perf_counter() - t0\n            wall_total += pre_wall\n            preflight = {\n                \"wall_seconds\": pre_wall,\n                \"exit_code\": proc.returncode,\n                \"stderr\": pre_err_out.read_text(encoding=\"utf-8\", errors=\"replace\")[-4000:],\n            }\n            try:\n                preflight[\"runtime\"] = json.loads(pre_out.read_text(encoding=\"utf-8\"))\n            except Exception as exc:\n                preflight[\"runtime_parse_error\"] = repr(exc)\n            preflight[\"import_origin_check\"] = verify_import_origin(preflight, root)\n            (out_dir / \"preflight.json\").write_text(\n                json.dumps(preflight, indent=2), encoding=\"utf-8\"\n            )\n        proc = None\n\n        t0 = time.perf_counter()\n        with open(stdout_path, \"wb\") as out_fh, open(stderr_path, \"wb\") as err_fh:\n            proc = subprocess.Popen(\n                args.command,\n                stdout=out_fh,\n                stderr=err_fh,\n                env=env,\n                cwd=args.cwd,\n            )\n            try:\n                proc.wait(timeout=max(1.0, args.timeout - wall_total))\n                status = \"EXIT\" if proc.returncode == 0 else f\"EXIT_{proc.returncode}\"\n                exit_code = proc.returncode\n            except subprocess.TimeoutExpired:\n                kill_tree(proc.pid)\n                try:\n                    proc.wait(timeout=30)\n                except subprocess.TimeoutExpired:\n                    pass\n                status = \"TIMEOUT\"\n                exit_code = proc.returncode\n        proc = None\n        main_wall = time.perf_counter() - t0\n        wall_total += main_wall\n\n        stdout_text = (\n            stdout_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n            if stdout_path.exists()\n            else \"\"\n        )\n        receipt = {\n            \"name\": args.name,\n            \"command\": args.command,\n            \"cwd\": str(Path(args.cwd)),\n            \"started_utc\": started_utc,\n            \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n            \"status\": status,\n            \"exit_code\": exit_code,\n            \"timeout_seconds\": args.timeout,\n            \"process_wall_seconds\": wall_total,\n            \"main_wall_seconds\": main_wall,\n            \"identity_hashes\": hashes,\n            \"child_env\": CHILD_ENV,\n            \"preflight_included\": preflight is not None,\n            \"import_origin_check\": (\n                (preflight or {}).get(\"import_origin_check\")\n                if preflight\n                else verify_import_origin(None, root)\n            ),\n            \"counts\": parse_counts(stdout_text),\n            \"head\": subprocess.run(\n                [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                capture_output=True,\n                text=True,\n            ).stdout.strip(),\n        }\n        (out_dir / \"receipt.json\").write_text(\n            json.dumps(receipt, indent=2), encoding=\"utf-8\"\n        )\n        receipt_written = True\n\n        budget[\"used_seconds\"] = used + wall_total\n        budget[\"attempts\"].append(\n            {\n                \"name\": args.name,\n                \"status\": status,\n                \"wall_seconds\": wall_total,\n                \"cumulative_used\": budget[\"used_seconds\"],\n                \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                \"started_utc\": started_utc,\n            }\n        )\n        save_budget(budget)\n        print(\n            f\"[harness] {args.name}: {status} wall={wall_total:.2f}s \"\n            f\"used={budget['used_seconds']:.1f}s \"\n            f\"remaining={ALLOWANCE - budget['used_seconds']:.1f}s\"\n        )\n        return 0 if status == \"EXIT\" else 1\n    except Exception as exc:  # noqa: BLE001 - accounting must survive any failure\n        harness_error = f\"{type(exc).__name__}: {exc}\"\n        status = \"HARNESS_ERROR\"\n        raise\n    finally:\n        # Unconditional process-tree cleanup and accounting. Any harness-side\n        # exception still writes a receipt, charges the measured wall time and\n        # removes the lock, preserving partial stdout/stderr.\n        if proc is not None and proc.poll() is None:\n            kill_tree(proc.pid)\n            try:\n                proc.wait(timeout=10)\n            except subprocess.TimeoutExpired:\n                pass\n        if not receipt_written:\n            try:\n                wall_total_final = wall_total if wall_total > 0 else 0.0\n                partial = {\n                    \"name\": args.name,\n                    \"command\": args.command,\n                    \"cwd\": str(Path(args.cwd)),\n                    \"started_utc\": started_utc,\n                    \"ended_utc\": datetime.now(timezone.utc).isoformat(),\n                    \"status\": status,\n                    \"exit_code\": exit_code,\n                    \"timeout_seconds\": args.timeout,\n                    \"process_wall_seconds\": wall_total_final,\n                    \"identity_hashes\": hashes,\n                    \"child_env\": CHILD_ENV,\n                    \"preflight_included\": preflight is not None,\n                    \"import_origin_check\": (\n                        (preflight or {}).get(\"import_origin_check\")\n                        if preflight\n                        else verify_import_origin(None, root)\n                    ),\n                    \"harness_error\": harness_error,\n                    \"partial_accounting\": True,\n                    \"head\": subprocess.run(\n                        [\"git\", \"-C\", str(REPO), \"rev-parse\", \"HEAD\"],\n                        capture_output=True,\n                        text=True,\n                    ).stdout.strip(),\n                }\n                (out_dir / \"receipt.json\").write_text(\n                    json.dumps(partial, indent=2), encoding=\"utf-8\"\n                )\n                budget[\"used_seconds\"] = used + wall_total_final\n                budget[\"attempts\"].append(\n                    {\n                        \"name\": args.name,\n                        \"status\": status,\n                        \"wall_seconds\": wall_total_final,\n                        \"cumulative_used\": budget[\"used_seconds\"],\n                        \"remaining\": ALLOWANCE - budget[\"used_seconds\"],\n                        \"started_utc\": started_utc,\n                    }\n                )\n                save_budget(budget)\n                print(\n                    f\"[harness] {args.name}: {status} (partial accounting) \"\n                    f\"wall={wall_total_final:.2f}s \"\n                    f\"used={budget['used_seconds']:.1f}s\",\n                    file=sys.stderr,\n                )\n            except Exception as exc:  # noqa: BLE001\n                print(f\"[harness] accounting failure: {exc!r}\", file=sys.stderr)\n        try:\n            LOCK_FILE.unlink()\n        except FileNotFoundError:\n            pass\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n"}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Created", "message": "C:\\Github\\ANYsolver\\.development\\nonlinear-master-slave-coupling-20261017\\harness.py", "warnings": [], "approvalNote": null, "suffix": ""}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
