{"id": "effect-15dfcf45-0944-5244-8d7e-5cce53371995", "sessionId": "d77c8371-229c-7034-6088-eaefcc4b4445", "turnId": "turn-6f19a1036e2fefd5642f253cb635b74b", "createdAt": 1792346782231, "updatedAt": 1792346782265, "generationStatus": "completed", "relatedEntryId": null, "type": "effect", "title": "file_system.read_file", "detail": {"toolName": "file_system.read_file", "display": {"summary": "Reading C:/Github/ANYsolver/src/anysolver/constraint_audit.py", "content": null, "suffix": "", "verb": "Reading", "message": "C:/Github/ANYsolver/src/anysolver/constraint_audit.py", "settledVerb": "Read", "settledMessage": "C:/Github/ANYsolver/src/anysolver/constraint_audit.py", "statusText": "Reading file"}, "kind": "file_read", "input": {"filePath": "C:/Github/ANYsolver/src/anysolver/constraint_audit.py", "offset": 401, "limit": 120}}, "state": {"status": "completed", "output": {"filePath": "C:\\Github\\ANYsolver\\src\\anysolver\\constraint_audit.py", "content": "\r\ndef audit_constraints(model: \"FEModel\") -> ConstraintAuditReport:\r\n    \"\"\"Audit fixed supports and affine MPCs without assembling FE matrices.\"\"\"\r\n    total_dofs = int(model.mesh.dof_manager.total_dofs)\r\n    equations, issues = _collect_equations(model)\r\n    owners: Dict[int, _Equation] = {}\r\n    redundant = 0\r\n\r\n    for equation in equations:\r\n        previous = owners.get(equation.dependent)\r\n        if previous is None:\r\n            owners[equation.dependent] = equation\r\n            continue\r\n        if previous.kind == equation.kind == \"support\" and np.isclose(previous.value, equation.value):\r\n            redundant += 1\r\n            issues.append(ConstraintAuditIssue(\"CONSTRAINT002\", \"warning\", f\"DOF {equation.dependent} has a duplicate prescribed constraint.\", equation.origin, equation.dependent))\r\n        else:\r\n            issues.append(ConstraintAuditIssue(\"CONSTRAINT002\", \"error\", f\"DOF {equation.dependent} has multiple dependent definitions ({previous.origin}, {equation.origin}).\", equation.origin, equation.dependent))\r\n\r\n    mpc_by_slave = {\r\n        dof: equation\r\n        for dof, equation in owners.items()\r\n        if equation.kind != \"support\"\r\n    }\r\n    visiting: Dict[int, int] = {}\r\n    depths: Dict[int, int] = {}\r\n\r\n    def visit(dof: int, path: Tuple[int, ...] = ()) -> int:\r\n        state = visiting.get(dof, 0)\r\n        if state == 1:\r\n            cycle = path[path.index(dof):] + (dof,) if dof in path else path + (dof,)\r\n            equation = mpc_by_slave[dof]\r\n            issues.append(ConstraintAuditIssue(\"CONSTRAINT003\", \"error\", f\"Circular MPC dependency detected: {' -> '.join(map(str, cycle))}.\", equation.origin, dof))\r\n            return 0\r\n        if state == 2:\r\n            return depths[dof]\r\n        visiting[dof] = 1\r\n        equation = mpc_by_slave[dof]\r\n        child_depths = [visit(master, path + (dof,)) for master in equation.coefficients if master in mpc_by_slave]\r\n        depth = 1 + max(child_depths, default=0)\r\n        depths[dof] = depth\r\n        visiting[dof] = 2\r\n        return depth\r\n\r\n    for slave in mpc_by_slave:\r\n        if visiting.get(slave, 0) == 0:\r\n            visit(slave)\r\n\r\n    error_count = sum(issue.severity == \"error\" for issue in issues)\r\n    dependent_count = len(owners)\r\n    fixed_count = sum(equation.kind == \"support\" for equation in owners.values())\r\n    mpc_count = sum(equation.kind != \"support\" for equation in owners.values())\r\n    homogeneous = all(abs(equation.value) <= COEFFICIENT_ATOL for equation in equations)\r\n    origin_counts: Dict[str, int] = {}\r\n    for equation in equations:\r\n        origin_counts[equation.kind] = origin_counts.get(equation.kind, 0) + 1\r\n    status = \"invalid\" if error_count else (\"warning\" if issues else \"ok\")\r\n    normalized_equations = tuple(\r\n        ConstraintEquation(\r\n            dependent_dof=equation.dependent,\r\n            coefficients=((equation.dependent, 1.0),)\r\n            + tuple(sorted((master, -coefficient) for master, coefficient in equation.coefficients.items())),\r\n            value=equation.value,\r\n            origin=equation.origin,\r\n            kind=equation.kind,\r\n        )\r\n        for equation in equations\r\n    )\r\n    return ConstraintAuditReport(\r\n        status=status,\r\n        total_dofs=total_dofs,\r\n        equation_count=len(equations),\r\n        structural_rank=dependent_count if not error_count else max(0, dependent_count),\r\n        redundant_equations=redundant,\r\n        independent_dofs=max(total_dofs - dependent_count, 0),\r\n        fixed_dofs=fixed_count,\r\n        mpc_slave_dofs=mpc_count,\r\n        homogeneous=homogeneous,\r\n        feasible=not bool(error_count),\r\n        max_dependency_depth=max(depths.values(), default=0),\r\n        origin_counts=origin_counts,\r\n        equations=normalized_equations,\r\n        issues=tuple(issues),\r\n    )\r\n\r\n\r\ndef constraint_residual_summary(\r\n    model: \"FEModel\",\r\n    displacements: np.ndarray,\r\n    *,\r\n    homogeneous_variation: bool = False,\r\n    affine_scale: float = 1.0,\r\n) -> Dict[str, Any]:\r\n    \"\"\"Return normalized support/MPC residuals for one vector or mode matrix.\r\n\r\n    ``affine_scale`` evaluates a proportional prescribed-displacement path,\r\n    where every affine right-hand side is multiplied by the current path\r\n    factor.  Eigenvector checks still use ``homogeneous_variation=True``.\r\n    \"\"\"\r\n    values = np.asarray(displacements, dtype=float)\r\n    if values.ndim == 1:\r\n        values = values.reshape(-1, 1)\r\n    if values.ndim != 2:\r\n        raise ValueError(\"constraint residual input must be a vector or 2D matrix\")\r\n    equations, collection_issues = _collect_equations(model)\r\n    total_dofs = int(model.mesh.dof_manager.total_dofs)\r\n    if values.shape[0] != total_dofs:\r\n        raise ValueError(f\"constraint residual input has {values.shape[0]} rows; expected {total_dofs}\")\r\n\r\n    max_absolute = 0.0\r\n    max_relative = 0.0\r\n    worst_origin = \"\"\r\n    residual_l2 = 0.0\r\n    for equation in equations:\r\n        prescribed = (\r\n            0.0 if homogeneous_variation else float(affine_scale) * equation.value\r\n        )\r\n        residual = values[equation.dependent, :] - prescribed\r\n        scale = np.maximum(np.abs(values[equation.dependent, :]), abs(prescribed))\r\n        for master, coefficient in equation.coefficients.items():\r\n", "numLines": 120, "startLine": 401, "requestedOffset": 401, "requestedLimit": 120, "totalLines": null, "wasTruncated": true}, "outputText": "", "durationMs": 0.0, "display": {"success": true, "verb": "Read", "message": "120 lines from C:\\Github\\ANYsolver\\src\\anysolver\\constraint_audit.py", "warnings": [], "approvalNote": null, "suffix": "(truncated)"}, "decision": "execute", "approvalType": "always", "approvalSource": "bypass"}}
{"id": "reasoning-24d788bc-de68-584a-90d0-55478f0f2a29-0", "sessionId": "d77c8371-229c-7034-6088-eaefcc4b4445", "turnId": "turn-6f19a1036e2fefd5642f253cb635b74b", "createdAt": 1792346787413, "updatedAt": 1792346787413, "generationStatus": "completed", "relatedEntryId": null, "type": "reasoning", "text": "The `require_valid_constraints(model)` returns a report with `equations` — each a `ConstraintEquation` with `dependent_dof`, `coefficients` (dict master → coefficient, where the relation is dependent = value - sum(coefficient*master)... actually normalized: coefficients = ((dependent,1.0),) + ((master, -coefficient)...), so equation: u_dependent + sum(-c_m * u_m) = value, i.e., u_dependent = value + sum(c_m * u_m)).\n\nSo for R1: for each equation with kind != \"support\" (i.e., MPC/equation kinds), check if any master (coefficient nonzero) is a rotating slave translation DOF. Also \"Reject mixed translation-to-rotation dependencies too\" — meaning if a downstream equation uses a rotating slave translation as master, reject regardless of the downstream slave's DOF type. And \"Rotating-slave rotations need not be banned solely because they are downstream: their map remains linear.\"\n\nWait, more precisely: \"Fail closed before constitutive activation when any other admitted affine equation uses a rotating slave *translation* as a nonzero master.\" So: any equation (other than the rotating descriptor's own defining equation? The rotating slave's own equation is the MPC that defines the slave from masters — that equation's masters are shell masters, not the slave itself) whose master set includes a rotating slave translation DOF → refuse.\n\nBut careful: the rotating descriptor's own slave_u_dofs are the beam node translations, which are slaves of the beam-shell MPC. The equation defining them has masters = shell DOFs. That's fine. The problem is a *different* equation that uses the beam slave translation as a master.\n\nAlso \"A second rotating coupling using B as its translational master has the same missing upstream correction\" — that's also an equation using a rotating slave translation as master (the second coupling's slave equation has B's translation as master). So the same check catches it.\n\nWhere to implement: in `build_nonlinear_rotating_mpc_map` in corotational.py — it has access to model. Use `require_valid_constraints(model)` from .constraint_audit. But wait — corotational.py importing constraint_audit — check for circular imports. constraint_audit imports... let me check its imports. It imports from typing, numpy, and TYPE_CHECKING fe_core probably. Fine.\n\nBut also the coefficient filtering: \"respecting the compiler's coefficient filtering\" — in build_constraint_transformation, masters with abs(coefficient) > 0.0 are kept after normalization... Actually in the audit's normalized equations, coefficients are kept as-is. The compiler filters `abs(float(v)) > 0.0` in slave_constraints masters. The audit's _collect_equations may already filter zeros. To be safe, filter masters with coefficient != 0.0.\n\nHmm, but there's a subtlety: the check should use \"the actual normalized constraint equations\" — the audit equations are normalized (dependent coefficient 1). Good.\n\nAlso: should the refusal happen only when the equation is actually admitted (i.e., the model would compile)? The audit report has status; require_valid_constraints presumably raises if invalid. In build_nonlinear_rotating_mpc_map, I'll call audit_constraints or require_valid_constraints. Let me check require_valid_constraints.\n\nAlso important: the ordinary linear chain case must still work — e.g., shell row ties (uy of shell nodes tied to each other) don't involve rotating slave translations. And \"upstream shell row ties\" — the rotating coupling's masters are shell nodes; a shell row tie that makes shell node S a slave of another shell node is upstream, fine.\n\nBut wait — there's an ordering subtlety: what if the rotating slave B's translation is used as master by an equation, but B's own equation... no, B is a slave; using a slave as master is allowed by the compiler (cascading). That's exactly the case to refuse.\n\nNow where exactly to raise? \"Fail closed before constitutive activation\" — build_nonlinear_rotating_mpc_map is called right after build_constraint_transformation in nonlinear_static (line 5527), before any constitutive evaluation. Raising ValueError there is fine. But build_nonlinear_rotating_mpc_map is also called in diagnostics (ep_edge_coupling.independent_residual) — those models don't have downstream dependencies, fine.\n\nImplementation in build_nonlinear_rotating_mpc_map:\n\n```python\nif entries:\n    rotating_slave_translations = set()\n    for entry in entries:\n        rotating_slave_translations.update(int(d) for d in entry.slave_u_dofs)\n    from .constraint_audit import require_valid_constraints\n    report = require_valid_constraints(model)\n    for equation in report.equations:\n        if equation.kind == \"support\":\n            continue\n        for master, coefficient in equation.coefficients.items():\n            if master == equation.dependent_dof:\n                continue\n            if float(coefficient) == 0.0:\n                continue\n            if int(master) in rotating_slave_translations:\n                raise ValueError(...)\n```\n\nWait — but the equation that defines the rotating slave itself: dependent = slave_u_dof, masters = shell dofs. master not in rotating set. OK.\n\nHmm, but one more: what about an equation whose dependent IS a rotating slave translation? That's the defining MPC — allowed (it's how the slave is defined). Only master usage is banned.\n\nError message: report the slave DOF and offending equation/element (origin).\n\nLet me check require_valid_constraints signature.", "summary": []}
