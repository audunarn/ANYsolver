est = (\\r\\n'\nb'        \"work_conjugate\"\\r\\n'\nb'        if rotating_mpc_present\\r\\n'\nb'        and str(corotational_tangent).lower() == \"auto\"\\r\\n'\nb'        and not follower_active\\r\\n'\nb'        else (\\r\\n'\nb'            \"consistent\"\\r\\n'\nb'            if armijo_requested\\r\\n'\nb'            and kinematics == \"corotational\"\\r\\n'\nb'            and str(corotational_tangent).lower() == \"auto\"\\r\\n'\nb'            else corotational_tangent\\r\\n'\nb'        )\\r\\n'\nb'    )\\r\\n'\n)\nassert data.count(old_r4) == 1, data.count(old_r4)\nnew_r4 = (\nb'    if rotating_mpc_present:\\r\\n'\nb'        requested_tangent = str(corotational_tangent).strip().lower()\\r\\n'\nb'        if requested_tangent == \"auto\":\\r\\n'\nb'            # The exact rotating-map route requires the work-conjugate\\r\\n'\nb'            # internal force.  Auto selects it with or without follower\\r\\n'\nb'            # loads; the external follower tangent is retained separately.\\r\\n'\nb'            tangent_request = \"work_conjugate\"\\r\\n'\nb'        elif requested_tangent in (\"rotated\", \"consistent\"):\\r\\n'\nb'            raise ValueError(\\r\\n'\nb'                \"corotational_tangent=\\'rotated\\' and \\'consistent\\' change \"\\r\\n'\nb'                \"the internal force law on the rotating-MPC route; use \"\\r\\n'\nb'                \"corotational_tangent=\\'auto\\' or \\'work_conjugate\\'.\"\\r\\n'\nb'            )\\r\\n'\nb'        else:\\r\\n'\nb'            tangent_request = corotational_tangent\\r\\n'\nb'    else:\\r\\n'\nb'        tangent_request = (\\r\\n'\nb'            \"consistent\"\\r\\n'\nb'            if armijo_requested\\r\\n'\nb'            and kinematics == \"corotational\"\\r\\n'\nb'            and str(corotational_tangent).lower() == \"auto\"\\r\\n'\nb'            else corotational_tangent\\r\\n'\nb'        )\\r\\n'\n)\ndata = data.replace(old_r4, new_r4, 1)\n\n# ---- R4 companion: follower pressure admission accepts the rot