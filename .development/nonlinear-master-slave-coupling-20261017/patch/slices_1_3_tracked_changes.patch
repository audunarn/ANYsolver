+def _nonlinear_minus_linear_rotation(theta: np.ndarray) -> np.ndarray:
+    """Return ``(R(theta) - I) - skew(theta)`` without small-angle cancellation."""
+    w = np.asarray(theta, dtype=float).reshape(3)
+    alpha = float(np.linalg.norm(w))
