+    model: "FEModel",
+    element_id: int,
+    element: Any,
+    u_element: np.ndarray,
+    tangent: bool = True,
+    committed_state: Optional[Any] = None,
+    num_layers: int = 5,
+    centered_shell_reference: bool = False,
+    stable_shell_rotation: bool = False,
